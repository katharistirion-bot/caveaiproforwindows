<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- x:Shared="False" → each ToggleButton gets its own visual tree instance. -->
    <Viewbox x:Key="SketchGlyphRock" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Path Stroke="Black" StrokeThickness="1" StrokeLineJoin="Round" Fill="#FF8B7B6E">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="True">
                            <PathFigure.StartPoint>
                                <Point X="3" Y="17" />
                            </PathFigure.StartPoint>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="7" Y="9" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="12" Y="7" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="20" Y="10" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="22" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="16" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="8" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SketchGlyphWater" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="8" Width="18" Height="13"
                     Stroke="Black" StrokeThickness="1" Fill="#BB3DA5D9" />
            <Line X1="4" Y1="10" X2="8" Y2="9" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="8" Y1="9" X2="12" Y2="11" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="12" Y1="11" X2="16" Y2="9" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="16" Y1="9" X2="20" Y2="10" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SketchGlyphSpele" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Path Stroke="Black" StrokeThickness="1" StrokeLineJoin="Round" Fill="#FFC4AA7F">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="True">
                            <PathFigure.StartPoint>
                                <Point X="12" Y="3" />
                            </PathFigure.StartPoint>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="16" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="20" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="12" Y="19" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="4" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="8" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- x:Shared="False" → each ToggleButton gets its own visual tree instance. -->
    <Viewbox x:Key="SketchGlyphRock" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Path Stroke="Black" StrokeThickness="1" StrokeLineJoin="Round" Fill="#FF8B7B6E">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="True">
                            <PathFigure.StartPoint>
                                <Point X="3" Y="17" />
                            </PathFigure.StartPoint>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="7" Y="9" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="12" Y="7" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="20" Y="10" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="22" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="16" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="8" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SketchGlyphWater" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Ellipse Canvas.Left="3" Canvas.Top="8" Width="18" Height="13"
                     Stroke="Black" StrokeThickness="1" Fill="#BB3DA5D9" />
            <Line X1="4" Y1="10" X2="8" Y2="9" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="8" Y1="9" X2="12" Y2="11" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="12" Y1="11" X2="16" Y2="9" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Line X1="16" Y1="9" X2="20" Y2="10" Stroke="Black" StrokeThickness="0.9" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="SketchGlyphSpele" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Canvas Width="24" Height="24">
            <Path Stroke="Black" StrokeThickness="1" StrokeLineJoin="Round" Fill="#FFC4AA7F">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure IsClosed="True">
                            <PathFigure.StartPoint>
                                <Point X="12" Y="3" />
                            </PathFigure.StartPoint>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="16" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="20" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="12" Y="19" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="4" Y="21" />
                                </LineSegment.Point>
                            </LineSegment>
                            <LineSegment>
                                <LineSegment.Point>
                                    <Point X="8" Y="17" />
                                </LineSegment.Point>
                            </LineSegment>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>
    <Viewbox x:Key="SketchGlyphFlow" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FFE8D4B0" Data="M 4 6 L 7 18 L 10 8 L 13 19 L 16 9 L 19 18 L 20 6 L 18 5 L 15 14 L 12 5 L 9 14 L 6 5 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphSand" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FFE6D3A1" Data="M 3 16 L 6 13 L 10 12 L 15 13 L 21 16 L 21 19 L 3 19 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphPit" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FF6E6258" Data="M 12 5 L 17 9 L 17 15 L 12 19 L 7 15 L 7 9 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphAid" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.2" Data="M 10 4 L 14 4 L 14 20 L 10 20 Z M 10 7 L 14 7 M 10 11 L 14 11 M 10 15 L 14 15" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphChoke" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FFB7A18A" Data="M 4 5 L 20 5 L 17 12 L 20 19 L 4 19 L 7 12 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphBreakdown" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.2" Data="M 3 19 L 20 19 M 5 19 L 7 15 L 10 19 M 9 18 L 12 13 L 15 18 M 14 17 L 17 14 L 19 17" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphColumn" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FFC4AA7F" Data="M 9 3 L 15 3 L 16 7 L 15 21 L 9 21 L 8 7 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphHelictite" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FFD7C4A3" Data="M 12 3 L 15 8 L 11 12 L 17 16 L 10 20 L 14 14 L 9 10 L 13 6 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphAven" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.1" Fill="#FF8D7B68" Data="M 7 19 L 12 5 L 17 19 L 14 19 L 12 11 L 10 19 Z" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphStream" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="#FF1F6FA5" StrokeThickness="1.4" Data="M 3 12 L 18 12 M 14 9 L 18 12 L 14 15" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphMud" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="#FF6B5344" StrokeThickness="1.3" Data="M 5 16 L 9 16 M 7 14 L 7 18 M 12 15 L 16 15 M 14 13 L 14 17 M 17 17 L 21 17 M 19 15 L 19 19" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphArchaeology" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="#FF8A5A44" StrokeThickness="1.3" Data="M 5 19 L 19 5 M 8 16 L 11 13 M 13 11 L 16 8 M 8 8 L 11 11 M 13 13 L 16 16" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphGuano" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="#FF5C5348" StrokeThickness="1.3" Data="M 4 14 L 8 14 M 6 12 L 6 16 M 11 16 L 15 16 M 13 14 L 13 18 M 16 12 L 20 12 M 18 10 L 18 14" />
    </Viewbox>
    <Viewbox x:Key="SketchGlyphCrack" x:Shared="False" Stretch="Uniform" Width="20" Height="20">
        <Path Stroke="Black" StrokeThickness="1.3" Data="M 12 4 L 9 10 L 15 14 L 10 20" />
    </Viewbox>
</ResourceDictionary>

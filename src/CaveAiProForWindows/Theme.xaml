<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CaveAiProForWindows.Converters"
                    xmlns:models="clr-namespace:CaveAiProForWindows.Models">
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    <conv:ProjectQcBadgeConverter x:Key="ProjectQcBadge" />

    <DataTemplate DataType="{x:Type models:ProjectQcBadgeInfo}">
        <Border x:Name="QcBadgeRoot" Padding="4,2" CornerRadius="4" Margin="4,0,0,0" VerticalAlignment="Center"
                Background="{DynamicResource Cave.CanvasBackdrop}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                ToolTip="{Binding Summary}">
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Glyph}"
                       Foreground="{Binding AccentBrushHex, Converter={StaticResource HexToBrush}}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Glyph}" Value="">
                <Setter TargetName="QcBadgeRoot" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Cave.LibraryCardHost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Cave.ButtonControlTemplate" TargetType="Button">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <ContentPresenter x:Name="Cp"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Cave.Accent}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Cave.ButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Cave.ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cave.ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template" Value="{StaticResource Cave.ButtonControlTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.ButtonBackgroundHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.ButtonForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cave.ButtonBorderHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.ButtonBackgroundPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.ButtonForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cave.ButtonBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Cave.ButtonDisabledForeground}" />
                <Setter Property="Background" Value="{DynamicResource Cave.ButtonDisabledBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cave.ButtonDisabledBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Cave.ButtonBase}" />
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource Cave.ButtonBase}" />

    <Style x:Key="Cave.AccentButton" TargetType="Button" BasedOn="{StaticResource Cave.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Cave.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.AccentButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cave.AccentPressed}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.AccentHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.AccentButtonForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cave.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.AccentPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.AccentButtonForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Cave.AccentDisabledForeground}" />
                <Setter Property="Background" Value="{DynamicResource Cave.AccentDisabledBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cave.AccentDisabledBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Cave.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.MenuItemHighlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cave.MenuItemHighlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource Cave.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.TextMuted}" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Cave.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cave.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource Cave.DataGridRow}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Cave.DataGridRowAlt}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Cave.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Cave.Border}" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Cave.DataGridHeaderBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <ControlTemplate x:Key="Cave.TabItemTemplate" TargetType="TabItem">
        <Border x:Name="TabBd"
                Background="{DynamicResource Cave.TabStripInactive}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0"
                Padding="14,10"
                Margin="0,0,4,2"
                SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Hdr"
                              ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.FontWeight="SemiBold"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource Cave.TabStripHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource Cave.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Cave.Accent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource Cave.TabItemTemplate}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Cave.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cave.Border}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cave.ListItemHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cave.ListItemSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cave.GridSplitterVertical" TargetType="GridSplitter">
        <Setter Property="Width" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Fill="{DynamicResource Cave.SplitterGrip}" Margin="0,8" RadiusX="1" RadiusY="1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cave.GridSplitterHorizontal" TargetType="GridSplitter">
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Fill="{DynamicResource Cave.SplitterGrip}" Margin="8,0" RadiusX="1" RadiusY="1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Foreground" Value="{DynamicResource Cave.TextSubdued}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{DynamicResource Cave.TextSubdued}" />
    </Style>
</ResourceDictionary>

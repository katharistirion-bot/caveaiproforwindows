<Window x:Class="CaveAiProForWindows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAVE AI PRO"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="680"
        Height="420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="IntroExperienceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="SplashEnter">
                <DoubleAnimation Storyboard.TargetName="LogoImage"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.7">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LogoImage"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 From="0.88" To="1" Duration="0:0:0.85">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LogoImage"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.88" To="1" Duration="0:0:0.85">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TitleBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.55" BeginTime="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="TaglineBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.4" />
                <DoubleAnimation Storyboard.TargetName="ProgressTrack"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.55" />
            </Storyboard>

            <Storyboard x:Key="ProgressShimmer" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="ProgressGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="0.95" Duration="0:0:1.1"
                                 AutoReverse="True" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="20"
            BorderBrush="#FF252D3D"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" Direction="270" ShadowDepth="10" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.Background>
                <StaticResource ResourceKey="Intro.BackgroundGradient" />
            </Grid.Background>

            <!-- Ambient glow -->
            <Rectangle Fill="{StaticResource Intro.AccentGlowBrush}" IsHitTestVisible="False" />

            <!-- Decorative survey lines -->
            <Canvas IsHitTestVisible="False" Opacity="0.14">
                <Path Stroke="#FF5B9DFF" StrokeThickness="1.2" Data="M 40,320 C 120,280 180,340 260,300 S 420,260 640,290" />
                <Path Stroke="#FF5B9DFF" StrokeThickness="0.8" Data="M 60,350 C 140,310 220,360 320,330 S 500,300 620,340" />
                <Path Stroke="#FF8BB4FF" StrokeThickness="0.6" Data="M 80,380 L 200,360 L 280,370 L 400,350 L 560,365" />
            </Canvas>

            <Grid Margin="48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image x:Name="LogoImage"
                       Grid.Row="0"
                       Width="128" Height="128"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#FF5B9DFF" />
                    </Image.Effect>
                </Image>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="TitleBlock"
                               Text="CAVE AI PRO"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FFF4F6FA"
                               HorizontalAlignment="Center"
                               Opacity="0" />
                    <TextBlock x:Name="TaglineBlock"
                               Text="Professional cave survey workstation"
                               FontSize="13.5"
                               Foreground="#FF8B95A8"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Opacity="0" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           x:Name="VersionLabel"
                           Text="Version 1.0"
                           FontSize="11.5"
                           Foreground="#FF5C6578"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />

                <Border Grid.Row="3"
                        x:Name="ProgressTrack"
                        Height="4"
                        Margin="0,28,0,0"
                        CornerRadius="2"
                        Background="#FF1E2430"
                        Opacity="0">
                    <Grid>
                        <Border x:Name="ProgressGlow"
                                CornerRadius="2"
                                Opacity="0.6"
                                HorizontalAlignment="Left"
                                Width="120">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#005B9DFF" Offset="0" />
                                    <GradientStop Color="#FF5B9DFF" Offset="0.5" />
                                    <GradientStop Color="#005B9DFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ProgressBar x:Name="ProgressBar"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Background="Transparent"
                                     Foreground="#FF5B9DFF"
                                     BorderThickness="0" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="StatusLabel"
                           Text="Preparing your workspace…"
                           FontSize="11.5"
                           Foreground="#FF6E7689"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="CaveAiProForWindows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAVE AI PRO — starting…"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Border Width="520"
            Padding="36,28"
            CornerRadius="14"
            Background="#FF101218"
            BorderBrush="#FF2A3040"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Width="120" Height="120"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed" />

            <TextBlock Grid.Row="1"
                       Text="CAVE AI PRO"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFEFF2F8"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />

            <TextBlock Grid.Row="2"
                       Text="Survey workstation · offline-first"
                       FontSize="12.5"
                       Foreground="#FF8A93A6"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />

            <TextBlock Grid.Row="3"
                       x:Name="VersionLabel"
                       Text="Version 1.0"
                       FontSize="12"
                       Foreground="#FFCBD2E0"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,16" />

            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             x:Name="ProgressBar"
                             Height="6"
                             IsIndeterminate="True"
                             Background="#FF1B1F2A"
                             Foreground="#FF6BA9FF"
                             BorderThickness="0" />
                <TextBlock Grid.Row="1"
                           x:Name="StatusLabel"
                           Text="Loading background services…"
                           FontSize="11"
                           Foreground="#FF6E7689"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>

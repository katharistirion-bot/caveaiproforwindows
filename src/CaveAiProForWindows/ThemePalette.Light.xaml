<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF050505" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FFE4E6EB" />

    <SolidColorBrush x:Key="Cave.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Cave.Background" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Cave.Border" Color="#FFCED0D4" />
    <SolidColorBrush x:Key="Cave.CanvasBackdrop" Color="#FFF5F6F7" />
    <SolidColorBrush x:Key="Cave.BannerTint" Color="#FFE7F3FF" />
    <SolidColorBrush x:Key="Cave.AnalyticsPriorityRow" Color="#FFFFF3D6" />
    <SolidColorBrush x:Key="Cave.AnalyticsCriticalRow" Color="#FFFFE0E0" />
    <SolidColorBrush x:Key="Cave.Accent" Color="#FF1877F2" />
    <SolidColorBrush x:Key="Cave.AccentHover" Color="#FF166FE5" />
    <SolidColorBrush x:Key="Cave.AccentPressed" Color="#FF1565C0" />
    <SolidColorBrush x:Key="Cave.AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Cave.Text" Color="#FF202020" />
    <SolidColorBrush x:Key="Cave.TextMuted" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Cave.TextSubdued" Color="#FF4B4B4B" />
    <SolidColorBrush x:Key="Cave.ButtonBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Cave.ButtonForeground" Color="#FF050505" />
    <SolidColorBrush x:Key="Cave.ButtonBorder" Color="#FFCCD0D5" />
    <SolidColorBrush x:Key="Cave.ButtonBackgroundHover" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Cave.ButtonBackgroundPressed" Color="#FFE4E6EB" />
    <SolidColorBrush x:Key="Cave.ButtonBorderHover" Color="#FF8A8D91" />
    <SolidColorBrush x:Key="Cave.ButtonDisabledForeground" Color="#FFB0B3B8" />
    <SolidColorBrush x:Key="Cave.ButtonDisabledBackground" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Cave.ButtonDisabledBorder" Color="#FFDADDE1" />
    <SolidColorBrush x:Key="Cave.AccentDisabledForeground" Color="#FFBCC0C4" />
    <SolidColorBrush x:Key="Cave.AccentDisabledBackground" Color="#FFE4E6EB" />
    <SolidColorBrush x:Key="Cave.AccentDisabledBorder" Color="#FFDADDE1" />
    <SolidColorBrush x:Key="Cave.MenuItemHighlight" Color="#FFE4E6EB" />
    <SolidColorBrush x:Key="Cave.TabStripInactive" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Cave.TabStripHover" Color="#FFE4E6EB" />
    <SolidColorBrush x:Key="Cave.DataGridRow" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Cave.DataGridRowAlt" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="Cave.DataGridHeaderBg" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="Cave.SplitterGrip" Color="#FFC5CAD3" />
    <SolidColorBrush x:Key="Cave.ListItemHover" Color="#FFE8EAEE" />
    <SolidColorBrush x:Key="Cave.ListItemSelected" Color="#FFDCE6F8" />

    <sys:Double x:Key="Cave.ToolSidebarFontSize">12.5</sys:Double>
    <sys:Double x:Key="Cave.ToolSidebarHintFontSize">11.5</sys:Double>
    <sys:Double x:Key="Cave.HudFontSize">12.5</sys:Double>
    <sys:Double x:Key="Cave.HudTitleFontSize">13</sys:Double>
    <sys:Double x:Key="Cave.DetailsTitleFontSize">13.5</sys:Double>
    <sys:Double x:Key="Cave.DetailsBodyFontSize">12</sys:Double>
</ResourceDictionary>

<Window x:Class="CaveAiProForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CaveAiProForWindows.Views"
        xmlns:services="clr-namespace:CaveAiProForWindows.Services"
        xmlns:legal="clr-namespace:CaveAiProForWindows.Services.Legal"
        xmlns:loc="clr-namespace:CaveAiProForWindows.Services.Localization"
        xmlns:conv="clr-namespace:CaveAiProForWindows.Converters"
        x:Name="Shell"
        Title="{Binding WindowTitle}"
        Height="780"
        Width="1180"
        MinHeight="520"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/logo.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:RecentPathDisplayConverter x:Key="RecentPathDisplay" />
    </Window.Resources>
    <Grid>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2" Background="{DynamicResource Cave.Surface}">
            <MenuItem x:Name="MenuFile" Header="_File">
                <MenuItem x:Name="MenuOpen" Header="_Open…" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Import Sur_vex…" Command="{Binding ImportSurvexCommand}"
                          ToolTip="Open a Survex .svx centerline (from to tape compass clino) as a CaveAI project — round-trip with Export → Survex." />
                <MenuItem Header="Import T_herion…" Command="{Binding ImportTherionCommand}"
                          ToolTip="Open a Therion .th centerline as a CaveAI project — round-trip with Export → Therion." />
                <MenuItem Header="_Close workspace" Command="{Binding CloseWorkspaceCommand}" InputGestureText="Ctrl+W"
                          ToolTip="Unload all opened backups, Cave Library snapshot, standalone maps, and ZIP list (so this session no longer references those files)." />
                <MenuItem Header="Open standalone _map(s)…" Command="{Binding OpenStandaloneMapsCommand}"
                          ToolTip="GeoTIFF, PNG/JPEG, PDF, SVG, KML/KMZ, GPX, DXF, … — merged into map assets for plan/section underlays and CSV export." />
                <MenuItem Header="_Clear standalone maps" Command="{Binding ClearStandaloneMapsCommand}" />
                <MenuItem Header="Show in _Explorer" Command="{Binding RevealCurrentFileInExplorerCommand}"
                          ToolTip="Select the open .json or .zip in File Explorer" />
                <Separator />
                <MenuItem Header="_Open from Survey Cloud…" Command="{Binding OpenSurveyProjectFromCloudCommand}"
                          ToolTip="Download a private survey JSON from Survey Cloud (Android → Windows open)." />
                <MenuItem Header="_Save to Survey Cloud…" Command="{Binding SaveSurveyProjectToCloudCommand}"
                          ToolTip="Upload the selected project JSON to Survey Cloud (Windows → Android / web)." />
                <Separator />
                <MenuItem x:Name="MenuSave" Header="_Save project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"
                          ToolTip="Write sketch mapObjects, AI assets, and all loaded projects back to the open .json or .zip file" />
                <Separator />
                <MenuItem x:Name="MenuExit" Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="Shots → _CSV" Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="Traverse → _Survex" Command="{Binding ExportSurvexCommand}" />
                <MenuItem Header="Traverse → _Therion (.th)" Command="{Binding ExportTherionCommand}"
                          ToolTip="Centerline for XTherion / therion (same shot order as Android export)" />
                <MenuItem Header="Therion _project folder…" Command="{Binding ExportTherionProjectCommand}"
                          ToolTip="Survey .th + plan/section .th2 with walls and speleo symbols" />
                <MenuItem Header="_Stations → CSV (x,y,z m)" Command="{Binding ExportStationsCsvCommand}"
                          ToolTip="Station coordinates in the PC plan frame (GIS-friendly)" />
                <MenuItem Header="_Registry (caves + catalog) → CSV" Command="{Binding ExportRegistryCsvCommand}" />
                <MenuItem Header="Maps _report → CSV" Command="{Binding ExportMapsReportCommand}"
                          ToolTip="All map asset rows (JSON/ZIP paths + standalone map files), UTF-8 BOM" />
                <MenuItem Header="_Survey &amp; QC report (TXT)…" Command="{Binding ExportSurveyQcReportCommand}"
                          ToolTip="Project summary + traverse statistics and QC hints (UTF-8 BOM) for the selected cave." />
                <MenuItem Header="Unified _QC report packet…" Command="{Binding ExportUnifiedQcReportCommand}"
                          ToolTip="Summary TXT + anomalies CSV + loops CSV + integrity/manifest (when ZIP loaded) in one folder." />
                <MenuItem Header="Export _all projects to folder…" Command="{Binding ExportAllProjectsToFolderCommand}"
                          ToolTip="For every loaded project: shots CSV; if traverse exists also Survex .svx, Therion .th, stations x,y,z CSV." />
                <Separator />
                <MenuItem Header="Plan → _SVG" Command="{Binding ExportPlanSvgCommand}" />
                <MenuItem Header="Plan → _DXF" Command="{Binding ExportPlanDxfCommand}" />
                <MenuItem Header="Section → SVG" Command="{Binding ExportSectionSvgCommand}" />
                <MenuItem Header="Section → DXF" Command="{Binding ExportSectionDxfCommand}" />
                <MenuItem Header="Long profile → SVG" Command="{Binding ExportLongProfileSvgCommand}" />
                <MenuItem Header="Survey _booklet (PDF)…" Command="{Binding ExportSurveyBookletCommand}"
                          ToolTip="Plan + section + long profile + 3D in one PDF" />
                <MenuItem Header="Cave _report (PDF)…" Command="{Binding ExportCaveReportPdfCommand}"
                          ToolTip="Plan + section + 3D + symbol inventory + traverse QC in one PDF" />
                <MenuItem Header="Export _Android backup ZIP…" Command="{Binding ExportAndroidBackupZipCommand}"
                          ToolTip="Single-project data.json + export_assets for Android import" />
                <MenuItem Header="Batch _maps to folder…" Command="{Binding ExportAllMapsToFolderCommand}"
                          ToolTip="Plan/Section/Long profile SVG + 3D PNG for every loaded project" />
                <Separator />
                <MenuItem Header="Selected project → _ZIP (data.json + plan PNG)…"
                          Click="ExportProjectWithPlanZip_Click"
                          ToolTip="Save the current cave as data.json (one project) plus a PNG of the PLAN tab canvas." />
                <Separator />
                <MenuItem Header="_Extract photos (ZIP)" Command="{Binding ExtractPhotosCommand}" />
                <MenuItem Header="Extract _full archive (ZIP)…" Command="{Binding ExtractFullArchiveCommand}" />
            </MenuItem>
            <MenuItem x:Name="MenuTools" Header="_Tools">
                <MenuItem Header="Data &amp; backup _inspector…" Click="OpenDataInspector_Click"
                          ToolTip="Summary, raw JSON scan, QC, shots table, catalog, ZIP archive, integrity — same panels as before, in a separate window." />
                <MenuItem Header="_Compare two backups…" Command="{Binding CompareBackupsCommand}" />
                <MenuItem Header="Survey _diff (legs/stations)…" Command="{Binding CompareSurveysCommand}" />
                <MenuItem Header="_Loop closure assistant…" Command="{Binding ShowLoopClosureAssistantCommand}" />
                <MenuItem Header="{x:Static loc:AppStrings.MenuDesignPlanFromSurvey}" Command="{Binding OpenDesignFromSurveyCommand}"
                          ToolTip="Open Sketch Editor and generate LRUD wall outlines + symbols from traverse (cartography → plan design)" />
                <Separator />
                <MenuItem Header="Publication _sheet…" Command="{Binding OpenPublicationSheetCommand}"
                          ToolTip="Composite survey presentation (elevation + plan + optional 3D) in a separate window — does not change existing map tabs." />
                <Separator />
                <MenuItem Header="_Share for collaboration…" Command="{Binding ShareCollaborationCommand}"
                          ToolTip="Create shared Firestore project — team comments + mobile push" />
                <Separator />
                <MenuItem Header="Reference vs _community compare…" Command="{Binding CompareReferenceCommunityCommand}" />
                <MenuItem Header="Survey vs _reference link…" Command="{Binding CompareSurveyToReferenceLinkCommand}"
                          ToolTip="Compare the selected project's entrance and traverse stats with its linked referenceCatalogLink." />
                <Separator />
                <MenuItem Header="{x:Static loc:AppStrings.MenuFieldTripPlanner}" Command="{Binding OpenFieldTripPlannerCommand}" />
                <MenuItem Header="Open shared field trip link…" Click="OpenSharedFieldTripLink_Click" />
                <MenuItem Header="{x:Static loc:AppStrings.MenuBatchSurveyQc}" Command="{Binding BatchSurveyQcCommand}" />
            </MenuItem>
            <MenuItem x:Name="MenuHelp" Header="_Help">
                <MenuItem Header="{x:Static loc:AppStrings.MenuReferenceCatalog}" Command="{Binding OpenPublicLibraryWithPickerCommand}"
                          ToolTip="Public Library — native catalog or web map (picker)." />
                <MenuItem Header="Public Library _WebView…" Click="OpenPublicLibraryWebView_Click"
                          ToolTip="Browse community-published caves in-app (WebView2 · Google sign-in)." />
                <MenuItem Header="{x:Static loc:AppStrings.MenuExploreMap}" Click="OpenExploreMapWebView_Click"
                          ToolTip="Terrain explore map for reference cave discovery (WebView2)." />
                <MenuItem Header="_Download from Public Library…" Command="{Binding DownloadPublicLibraryBackupCommand}"
                          ToolTip="Fetch surveyJsonUrl + cartography assets into a local .zip or .json backup." />
                <MenuItem Header="Cave _AI on web…" Command="{Binding OpenCaveAiWebCommand}"
                          ToolTip="Opens caveaipro.com/ai in your browser (uses linked reference pin context when available)." />
                <MenuItem Header="Public Library in _browser…" Click="OpenPublicLibraryExternal_Click"
                          ToolTip="Open the web map in your default browser." />
                <MenuItem Header="_Following contributors…" Click="OpenFollowingPublishers_Click" />
                <Separator />
                <MenuItem x:Name="MenuCheckUpdates" Header="Check for _updates…" Command="{Binding CheckForUpdatesCommand}"
                          ToolTip="Check GitHub Releases (Velopack Setup.exe install gets in-app updates; MSI opens release page)" />
                <MenuItem Header="Open _diagnostic folder…" Command="{Binding OpenDiagnosticFolderCommand}"
                          ToolTip="Opens %LOCALAPPDATA%\CaveAiProForWindows (startup.log, last-error.txt)" />
                <MenuItem Header="{x:Static loc:AppStrings.MenuExportDiagnosticBundle}" Command="{Binding ExportDiagnosticBundleCommand}"
                          ToolTip="Zip logs and redacted ui-settings for support." />
                <MenuItem x:Name="MenuIntroVideo" Header="_Intro video…" Click="ReplayIntroVideo_Click"
                          ToolTip="Replay the CAVE AI PRO intro (Skip anytime with Esc)" />
                <MenuItem x:Name="MenuAbout" Header="_About" Command="{Binding AboutCommand}" InputGestureText="F1" />
                <MenuItem x:Name="MenuKeyboardShortcuts" Header="_Keyboard shortcuts…" Command="{Binding ShowKeyboardShortcutsCommand}" />
                <Separator />
                <MenuItem x:Name="MenuSwitchAccount" Header="{x:Static loc:AppStrings.MenuSwitchAccount}" Click="SwitchGoogleAccount_Click"
                          ToolTip="Sign out and sign in with a different Google account (subscription required)." />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Padding="12,8"
                Margin="0,0,0,4"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding LegalTermsAccepted, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,6"
                        Style="{StaticResource Cave.AccentButton}"
                        Content="Open LEGAL &amp; SETTINGS…"
                        Click="LegalRequiredOverlay_GoToLegal_Click" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Cave.TextMuted}"
                           Text="Accept the End User License Agreement on the LEGAL &amp; SETTINGS tab before export, cloud publish, or collaboration." />
            </DockPanel>
        </Border>

        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource Cave.Surface}" Margin="0,0,0,4">
            <ToolBar ToolBarTray.IsLocked="True" Background="Transparent" Padding="4,2"
                     DataContext="{Binding DataContext, ElementName=Shell}">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                            ToolTip="CAVE AI PRO — Windows survey workstation">
                    <Image Width="40" Height="40" Margin="0,0,10,0" Stretch="Uniform"
                           Source="pack://application:,,,/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CAVE AI PRO"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Cave.Text}" />
                        <TextBlock Text="{Binding ToolbarVersionText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ToolbarOpenButton" Content="Open" Command="{Binding OpenFileCommand}" Padding="12,6" Margin="0,0,6,0"
                        Style="{StaticResource Cave.AccentButton}" />
                <Separator />
                <Button Content="CSV" Command="{Binding ExportCsvCommand}" ToolTip="Export shots CSV" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Survex" Command="{Binding ExportSurvexCommand}" ToolTip="Export traverse .svx" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Therion" Command="{Binding ExportTherionCommand}" ToolTip="Export traverse .th" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Photos" Command="{Binding ExtractPhotosCommand}" ToolTip="Extract photos from ZIP" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Explorer" Command="{Binding RevealCurrentFileInExplorerCommand}" ToolTip="Show current file in Explorer" Padding="10,6" Margin="0,0,4,0" />
                <Separator />
                <Button Content="Public Library" Command="{Binding OpenPublicLibraryWithPickerCommand}"
                        Click="OpenPublicLibraryToolbar_Click"
                        ToolTip="Public Library — native catalog or web map" Padding="10,6" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Cave.Surface}" Padding="4,2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding SiteIdentityTooltip}"
                           TextTrimming="CharacterEllipsis" MaxWidth="680"
                           Foreground="{DynamicResource Cave.TextSubdued}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CollaborationUnreadCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="💬" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding CollaborationUnreadCount}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cave.Accent}" ToolTip="Unread collaboration comments" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding AuthStatusChip}" TextTrimming="CharacterEllipsis" MaxWidth="320"
                           FontWeight="SemiBold" Cursor="Hand"
                           Foreground="{DynamicResource Cave.Accent}"
                           ToolTip="Click: open sign-in or LEGAL &amp; SETTINGS when action is needed"
                           MouseLeftButtonUp="AuthStatusChip_Click" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding FooterContextLine}" TextTrimming="CharacterEllipsis" MaxWidth="360"
                           Foreground="{DynamicResource Cave.TextSubdued}" ToolTip="Android sync folder, subscription, last backup age" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SourcePathDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Foreground="{DynamicResource Cave.TextSubdued}" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Padding="8,6" Margin="0"
                Background="{DynamicResource Cave.BannerTint}" BorderBrush="#FF64748B" BorderThickness="0,0,0,1"
                Visibility="{Binding StoreReviewBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static loc:AppStrings.StoreReviewBuildBanner}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Cave.TextSubdued}" />
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0"
                Background="#FF1A2332" BorderBrush="#FF2563EB" BorderThickness="0,0,0,1"
                Visibility="{Binding AccountBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static loc:AppStrings.AccountBannerManagePlay}" Padding="12,5" Margin="0,0,8,0"
                            Command="{Binding OpenPlayStoreFromBannerCommand}"
                            Style="{StaticResource Cave.AccentButton}" />
                    <Button Content="{x:Static loc:AppStrings.AccountBannerDismiss}" Padding="12,5"
                            Command="{Binding DismissAccountBannerCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AccountBannerMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#FFE2E8F0" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0"
                Background="#FF312E81" BorderBrush="#FF6366F1" BorderThickness="0,0,0,1"
                Visibility="{Binding UpdateAvailableBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{x:Static loc:AppStrings.UpdateAvailableOpenRelease}" Padding="12,5" Margin="0,0,8,0"
                            Command="{Binding OpenPendingReleasePageCommand}"
                            Style="{StaticResource Cave.AccentButton}" />
                    <Button Content="{x:Static loc:AppStrings.UpdateAvailableDismiss}" Padding="12,5"
                            Command="{Binding DismissUpdateAvailableBannerCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateAvailableBannerMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#FFE2E8F0" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0"
                Background="#FF1E293B" BorderBrush="#FF0D9488" BorderThickness="0,0,0,1"
                Visibility="{Binding AndroidSyncBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AndroidSyncReloadButton" Content="Reload now" Padding="12,5" Margin="0,0,8,0"
                            Command="{Binding ReloadPendingAndroidBackupCommand}"
                            Style="{StaticResource Cave.AccentButton}" />
                    <Button x:Name="AndroidSyncDismissButton" Content="Dismiss" Padding="12,5" Command="{Binding DismissAndroidSyncBannerCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AndroidSyncBannerMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#FFE2E8F0" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Border Margin="10" Padding="8"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Border Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource Cave.Surface}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Click to open the INTEGRITY tab for full details"
                        MouseLeftButtonUp="IntegrityBanner_MouseLeftButtonUp"
                        Visibility="{Binding ShowIntegrityBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding IntegrityBannerText}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{Binding IntegrityBannerColorHex, Converter={StaticResource HexToBrush}}" />
                </Border>
                <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource Cave.BannerTint}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Visibility="{Binding ShowSchemaNote, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SchemaNoteText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Cave.TextSubdued}" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RecentFilesColumn" Width="220" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Recent files" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Cave.Text}" />
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,8,0,0"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="0,1,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextSubdued}" FontSize="11"
                                   Text="Phone: CaveAI Pro from Google Play → Settings / backup → ZIP under Downloads/CaveAI, or copy caveai_database_v1.json. This PC app (x64) is not from Play." />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Padding="6,4" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.OpenRecentCommand, ElementName=Shell}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding}">
                                            <TextBlock Text="{Binding Converter={StaticResource RecentPathDisplay}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button Grid.Column="1" Padding="4,2" MinWidth="24" Margin="2,0,0,0"
                                                Content="×"
                                                ToolTip="Remove from recent list (does not delete the file)"
                                                Command="{Binding DataContext.RemoveRecentCommand, ElementName=Shell}"
                                                CommandParameter="{Binding}" />
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open"
                                                          Command="{Binding Path=DataContext.OpenRecentCommand, Source={x:Reference Shell}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Show in Explorer"
                                                          Command="{Binding Path=DataContext.RevealRecentPathCommand, Source={x:Reference Shell}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Rename…"
                                                          Command="{Binding Path=DataContext.RenameRecentPathCommand, Source={x:Reference Shell}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Delete…"
                                                          Command="{Binding Path=DataContext.DeleteRecentPathCommand, Source={x:Reference Shell}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Remove from list"
                                                          Command="{Binding Path=DataContext.RemoveRecentCommand, Source={x:Reference Shell}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProjectsColumn" Width="280" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Projects" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Cave.Text}" />
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Cave.TextMuted}" FontSize="12" />
                            <TextBox Text="{Binding ProjectListFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                     ToolTip="Filter by cave name or survey date"
                                     Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                     BorderBrush="{DynamicResource Cave.Border}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8"
                                   IsEnabled="{Binding HasSelectedProjectForSiteType}">
                            <TextBlock DockPanel.Dock="Left" Text="Site type" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Cave.TextMuted}" FontSize="12"
                                       ToolTip="Cave / Mine / Pothole / Spring — saved to surveySiteType in data.json on Save (Ctrl+S)" />
                            <ComboBox ItemsSource="{x:Static services:SurveySiteType.PickerTokens}"
                                      SelectedItem="{Binding SelectedProjectSiteTypeToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding HasSelectedProjectForSiteType}"
                                      Padding="6,4"
                                      ToolTip="Mirrors Android dossier tokens (CAVE, MINE, POTHOLE, SPRING)" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Text="After opening a backup, click a cave — PLAN / SECTION / 3D MODEL / … stay empty until a project is selected. INTEGRITY: ZIP SHA-256. SURVEY QC: traverse topology checks. SKETCH EDITOR: plan base map + overlay sketches. Tools → Data inspector for JSON scan, shots grid, catalog, ZIP." />
                        <ListBox ItemsSource="{Binding ProjectsForList}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}"
                                 Foreground="{DynamicResource Cave.Text}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <ContentControl Grid.Column="1"
                                                        Content="{Binding Converter={StaticResource ProjectQcBadge}}"
                                                        Focusable="False" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />

                    <Grid Grid.Column="2" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <ToggleButton x:Name="TabGroupSurvey" Content="Survey" Padding="14,6" Margin="0,0,6,0"
                                          IsChecked="True" Click="TabGroup_Click" Style="{StaticResource Cave.TabGroupToggle}"
                                          ToolTip="Plan, section, 3D, maps, and survey tools" />
                            <ToggleButton x:Name="TabGroupLibrary" Content="Library" Padding="14,6" Margin="0,0,6,0"
                                          Click="TabGroup_Click" Style="{StaticResource Cave.TabGroupToggle}"
                                          ToolTip="Integrity checks and survey QC" />
                            <ToggleButton x:Name="TabGroupPublish" Content="Publish" Padding="14,6" Margin="0,0,6,0"
                                          Click="TabGroup_Click" Style="{StaticResource Cave.TabGroupToggle}"
                                          ToolTip="Cloud publish shortcuts (Ctrl+K → Push to Cloud)" />
                            <ToggleButton x:Name="TabGroupSettings" Content="Settings" Padding="14,6"
                                          Click="TabGroup_Click" Style="{StaticResource Cave.TabGroupToggle}"
                                          ToolTip="Legal acceptance, preferences, and about" />
                        </StackPanel>
                        <TabControl Grid.Row="1" x:Name="MainSurveyTabControl"
                                    Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}"
                                    Padding="0,2,0,0"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <TabItem Header="PLAN" x:Name="PlanTab" ToolTip="Plan view (Android) — standard colours">
                            <ContentControl x:Name="PlanTabHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="SECTION" ToolTip="Section view (viewMode 1) — standard">
                            <views:SectionView VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 VisualizationMode="{x:Static services:SurveyVisualizationMode.Standard}"
                                                 Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                                 ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}"
                                                 MapRows="{Binding DataContext.MapAssetRows, ElementName=Shell}"
                                                 MapInventory="{Binding DataContext.MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="3D MODEL" x:Name="Model3DTab" ToolTip="Pseudo-3D projection (plan walls + vectors)">
                            <ContentControl x:Name="Model3DTabHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="LONG PROFILE" ToolTip="Developed distance vs depth (Z)">
                            <views:PlanView VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            VisualizationMode="{x:Static services:SurveyVisualizationMode.LongProfile}"
                                            Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                            ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}"
                                            MapRows="{Binding DataContext.MapAssetRows, ElementName=Shell}"
                                            MapInventory="{Binding DataContext.MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="GEO &amp; BIO" ToolTip="Offline reader for Android Cave AI analyses, rock textures, and biological observations (split into Geology / Biology sub-tabs)">
                            <views:GeoBioView VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"
                                              Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                              ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="PHOTOS" ToolTip="Global photo gallery — every JPEG/PNG in the active backup grouped by station / category, click for full-screen LightBox">
                            <views:PhotosExplorerView VerticalAlignment="Stretch"
                                                      HorizontalAlignment="Stretch"
                                                      Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                                      ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="X-RAY" x:Name="XRayTab" ToolTip="Geo-calibrated satellite map: bounding-box alignment, zoom/pan, station pick syncs Plan/Section">
                            <ContentControl x:Name="XRayTabHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="SURFACE" x:Name="SurfaceTab" ToolTip="MapLibre surface map around cave entrance — OSM basemap, hillshade/terrain, entrance pin">
                            <ContentControl x:Name="SurfaceTabHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="PLAN 2-TONE" ToolTip="Two-tone walls, dark canvas">
                            <views:PlanView VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            VisualizationMode="{x:Static services:SurveyVisualizationMode.Plan2Tone}"
                                            Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                            ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}"
                                            MapRows="{Binding DataContext.MapAssetRows, ElementName=Shell}"
                                            MapInventory="{Binding DataContext.MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="SECTION NIGHT" ToolTip="Section — dark canvas, high contrast">
                            <views:SectionView VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 VisualizationMode="{x:Static services:SurveyVisualizationMode.SectionNight}"
                                                 Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                                 ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}"
                                                 MapRows="{Binding DataContext.MapAssetRows, ElementName=Shell}"
                                                 MapInventory="{Binding DataContext.MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem x:Name="IntegrityTabItem" Header="INTEGRITY"
                                 ToolTip="Android backup integrity_manifest.json — SHA-256 file checks vs this ZIP">
                            <DockPanel Margin="10" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource Cave.TextMuted}" FontSize="12.5"
                                           Text="Each row is from verifying integrity_manifest.json against the opened backup ZIP (size + SHA-256). Use this list to find missing files, hash mismatches, or a skipped check." />
                                <DataGrid ItemsSource="{Binding IntegrityIssueRows}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Background="{DynamicResource Cave.Surface}"
                                          Foreground="{DynamicResource Cave.Text}"
                                          BorderBrush="{DynamicResource Cave.Border}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="SURVEY QC"
                                 ToolTip="Traverse graph checks — same topology rules as CaveAI Pro workstation QC (duplicate legs, disconnected components, etc.)">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Cave.TextMuted}" FontSize="12.5"
                                           Text="Traverse statistics (readonly box) mirror TraverseQcStats.BuildSummaryText. The DataGrid is bound to SurveyQcIssueRows — populated by TraverseQcStats.BuildSurveyQcIssueRows for the selected project (duplicate legs, disconnected components, bidirectional pairs, etc.). All processing is local to this Windows WPF app." />
                                <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                        Background="{DynamicResource Cave.BannerTint}"
                                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding OfflineBrainHintText, Mode=OneWay}" TextWrapping="Wrap"
                                               FontSize="11.5" Foreground="{DynamicResource Cave.TextMuted}"
                                               ToolTip="On-device survey hints (no cloud AI)" />
                                </Border>
                                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Ask" Padding="12,6" Margin="8,0,0,0"
                                            Command="{Binding AskCaveAiCommand}"
                                            ToolTip="On-device Cave AI — answers from the open survey only" />
                                    <TextBox Text="{Binding CaveAiQueryText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6"
                                             ToolTip="Ask about depth, traverse, loops, volume, or next step"
                                             Background="{DynamicResource Cave.Surface}"
                                             Foreground="{DynamicResource Cave.Text}"
                                             BorderBrush="{DynamicResource Cave.Border}" />
                                </DockPanel>
                                <TextBox Grid.Row="3" Text="{Binding CaveAiAnswerText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         MinHeight="72" MaxHeight="140" Margin="0,0,0,10" Padding="8"
                                         FontSize="12.5"
                                         Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                         BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" />
                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Text="{Binding StatisticsText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         MinHeight="120" MaxHeight="220" Margin="0,0,0,10" Padding="8"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                         BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SurveyQcIssueRows}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Background="{DynamicResource Cave.Surface}"
                                          Foreground="{DynamicResource Cave.Text}"
                                          BorderBrush="{DynamicResource Cave.Border}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="SketchEditorTabItem" Header="SKETCH EDITOR"
                                 ToolTip="Plan survey as base map — draw and stamp symbols on a transparent overlay (same pan/zoom as PLAN). After cartography, use Procedural Assist for LRUD walls.">
                            <views:SketchEditorView x:Name="SketchEditorControl" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                    VisualizationMode="{x:Static services:SurveyVisualizationMode.Standard}"
                                                    Project="{Binding DataContext.SelectedProject, ElementName=Shell}"
                                                    ZipPath="{Binding DataContext.ActiveZipPathForMaps, ElementName=Shell}"
                                                    MapRows="{Binding DataContext.MapAssetRows, ElementName=Shell}"
                                                    MapInventory="{Binding DataContext.MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="SURVEY INTELLIGENCE"
                                 ToolTip="Offline survey dashboard — project health, Android sync, backup diff, batch QC, and rule-based insights (no cloud AI)">
                            <Grid>
                                <views:AiAnalyticsView VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      Project="{Binding DataContext.SelectedProject, ElementName=Shell}" />
                                <Border Panel.ZIndex="2"
                                        Background="#CC0D0F14"
                                        CornerRadius="0"
                                        Visibility="{Binding DataContext.LegalTermsAccepted, ElementName=Shell, Converter={StaticResource InverseBoolToVis}}">
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="28"
                                            Padding="24" CornerRadius="10"
                                            Background="{DynamicResource Cave.Surface}"
                                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Cave.Text}"
                                                       Text="Terms acceptance required" />
                                            <TextBlock Margin="0,14,0,0" FontSize="13.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Cave.TextMuted}"
                                                       Text="Local AI analytics and batch export features stay locked until you accept the disclaimer on the LEGAL &amp; SETTINGS tab. Survey viewing and integrity checks remain available. No network or API keys are required for analysis." />
                                            <Button Margin="0,22,0,0" HorizontalAlignment="Left" Padding="16,9"
                                                    Style="{StaticResource Cave.AccentButton}"
                                                    Content="Open LEGAL &amp; SETTINGS…"
                                                    Click="LegalRequiredOverlay_GoToLegal_Click" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="LegalSettingsTabItem" Header="LEGAL &amp; SETTINGS"
                                 ToolTip="Disclaimer, copyright, and terms acceptance">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                                <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                                    <Border Padding="20"
                                            CornerRadius="10"
                                            Margin="0,0,0,18"
                                            Background="{DynamicResource Cave.Surface}"
                                            BorderBrush="{DynamicResource Cave.Border}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"
                                                   Width="160" Height="160"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,22,0"
                                                   Source="pack://application:,,,/Assets/logo.png"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   ToolTip="CAVE AI PRO" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="CAVE AI PRO"
                                                           FontSize="26"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Cave.Text}" />
                                                <TextBlock Text="Windows survey workstation"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           Margin="0,2,0,10" />
                                                <TextBlock x:Name="LegalCopyrightText"
                                                           Text="Copyright © 2026 Georgios Kourentzis. All Rights Reserved."
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Cave.Text}"
                                                           Margin="0,8,0,2" />
                                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           Text="{x:Static legal:LegalTexts.TrademarkNotice}" />
                                                <TextBlock x:Name="LegalPublisherMetaText"
                                                           TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource Cave.TextSubdued}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Separator Margin="0,0,0,16" />
                                    <TextBlock Text="Legal disclaimer &amp; EULA (English)" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                                    <Border Padding="0" CornerRadius="6" Margin="0,0,0,12"
                                            Background="{DynamicResource Cave.CanvasBackdrop}"
                                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                            MinHeight="240">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360"
                                                      Padding="10,8">
                                            <RichTextBox x:Name="LegalDisclaimerRichText"
                                                         IsReadOnly="True"
                                                         IsDocumentEnabled="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="2"
                                                         Foreground="{DynamicResource Cave.Text}"
                                                         VerticalScrollBarVisibility="Disabled"
                                                         HorizontalScrollBarVisibility="Disabled" />
                                        </ScrollViewer>
                                    </Border>
                                    <CheckBox Margin="0,4,0,16"
                                              FontSize="13.5"
                                              Foreground="{DynamicResource Cave.Text}"
                                              IsChecked="{Binding DataContext.LegalTermsAccepted, ElementName=Shell, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBlock TextWrapping="Wrap" MaxWidth="860"
                                                   Text="I Agree and Accept the End User License Agreement (EULA). I acknowledge that Georgios Kourentzis owns all intellectual property in CAVE AI PRO and that my use is licensed, not a sale of ownership." />
                                    </CheckBox>
                                    <TextBlock Text="{Binding DataContext.ReferenceLinkSummary, ElementName=Shell}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
                                               Foreground="{DynamicResource Cave.Accent}" />
                                    <TextBlock Text="Privacy summary" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,16"
                                               Foreground="{DynamicResource Cave.TextMuted}"
                                               Text="{x:Static legal:LegalTexts.PrivacySummary}" />
                                    <TextBlock Text="About this build" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,12"
                                               Foreground="{DynamicResource Cave.TextMuted}"
                                               Text="CAVE AI PRO for Windows is an offline-first survey workstation. Core analytics and exports require no cloud APIs." />
                                    <CheckBox x:Name="ShowReferencePinsSetting"
                                              Margin="0,0,0,8"
                                              FontSize="13"
                                              Foreground="{DynamicResource Cave.Text}"
                                              Content="Show nearby reference catalog pins on X-RAY map (cached index, max 50)"
                                              Click="ShowReferencePinsSetting_Changed" />
                                    <CheckBox x:Name="ShowReferencePinsOnPlanSetting"
                                              Margin="0,0,0,12"
                                              FontSize="13"
                                              Foreground="{DynamicResource Cave.Text}"
                                              Content="Show reference catalog pins on PLAN tab (linked entrance + nearby cached index)"
                                              Click="ShowReferencePinsOnPlanSetting_Changed" />
                                    <Separator Margin="0,0,0,16" />
                                    <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock Text="Android sync folder" FontSize="12" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,6" Margin="8,0,0,0"
                                                Click="PreferencesBrowseSyncFolder_Click" />
                                        <TextBox x:Name="PreferencesSyncFolderBox" Padding="8,6" IsReadOnly="True" />
                                    </DockPanel>
                                    <TextBlock Text="Default export folder (optional)" FontSize="12" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,6" Margin="8,0,0,0"
                                                Click="PreferencesBrowseExportFolder_Click" />
                                        <TextBox x:Name="PreferencesExportFolderBox" Padding="8,6" IsReadOnly="True" />
                                    </DockPanel>
                                    <TextBlock Text="Map export quality" FontSize="12" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="PreferencesMapQualityCombo" Margin="0,0,0,12" Padding="8,6"
                                              SelectionChanged="PreferencesMapQualityCombo_SelectionChanged">
                                        <ComboBoxItem Content="Standard (~300 DPI)" Tag="Standard" />
                                        <ComboBoxItem Content="Print (~600 DPI)" Tag="Print" />
                                    </ComboBox>
                                    <CheckBox x:Name="PreferencesDarkThemeCheck" Margin="0,0,0,8" FontSize="13"
                                              Content="Dark theme (survey maps and shell)"
                                              Click="PreferencesDarkThemeCheck_Changed" />
                                    <CheckBox x:Name="PreferencesTelemetryCheck" Margin="0,0,0,8" FontSize="13"
                                              Content="Send anonymized error reports when signed in"
                                              Click="PreferencesTelemetryCheck_Changed" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="PreferencesLastErrorText" TextWrapping="Wrap" FontSize="11.5"
                                                   MaxWidth="640" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Cave.TextMuted}" />
                                        <Button Content="Copy for support" Padding="10,6" Margin="12,0,0,0"
                                                Click="PreferencesCopyLastError_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="PreferencesPublishHistoryText" TextWrapping="Wrap" FontSize="11.5"
                                               Margin="0,0,0,12" Foreground="{DynamicResource Cave.TextSubdued}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        </TabControl>

                        <Border Panel.ZIndex="2"
                                Background="{DynamicResource Cave.Background}"
                                Opacity="0.96"
                                CornerRadius="8"
                                Margin="0,4,0,0"
                                Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
                                <TextBlock Text="CAVE AI PRO" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource Cave.TextMuted}"
                                           Text="Open a backup from CaveAI Pro on Android: a .json database or a full .zip (with data.json). Drag and drop files here, or use Open." />
                                <Button Content="Open backup…" Command="{Binding OpenFileCommand}"
                                        Style="{StaticResource Cave.AccentButton}" HorizontalAlignment="Center"
                                        Padding="20,10" Margin="0,20,0,0" FontSize="14" />
                                <TextBlock Text="Ctrl+O · F1 About · Help → Keyboard shortcuts" FontSize="12"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextAlignment="Center"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Border>
    </DockPanel>
    <Border Background="#AA000000" Visibility="{Binding ShowLoadProgress, Converter={StaticResource BoolToVis}}"
            Panel.ZIndex="20">
        <Border Background="{DynamicResource Cave.Surface}" Padding="24" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
            <StackPanel>
                <TextBlock Text="{Binding LoadProgressMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                <Button Content="Cancel" HorizontalAlignment="Right" Padding="14,6"
                        Command="{Binding CancelLoadCommand}" />
            </StackPanel>
        </Border>
    </Border>
    <views:SnackbarHost x:Name="MainSnackbar" />
    </Grid>
</Window>

<Window x:Class="CaveAiProForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CaveAiProForWindows.Views"
        x:Name="Shell"
        Title="{Binding WindowTitle}"
        Height="780"
        Width="1180"
        MinHeight="520"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open standalone _map(s)…" Command="{Binding OpenStandaloneMapsCommand}"
                          ToolTip="GeoTIFF, PNG/JPEG, PDF, SVG, KML/KMZ, GPX, DXF, … — rows appear in the Maps tab with project “(standalone)”." />
                <MenuItem Header="_Clear standalone maps" Command="{Binding ClearStandaloneMapsCommand}" />
                <MenuItem Header="Show in _Explorer" Command="{Binding RevealCurrentFileInExplorerCommand}"
                          ToolTip="Select the open .json or .zip in File Explorer" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="Shots → _CSV" Command="{Binding ExportCsvCommand}" />
                <MenuItem Header="Traverse → _Survex" Command="{Binding ExportSurvexCommand}" />
                <MenuItem Header="Traverse → _Therion (.th)" Command="{Binding ExportTherionCommand}"
                          ToolTip="Centerline for XTherion / therion (same shot order as Android export)" />
                <MenuItem Header="_Stations → CSV (x,y,z m)" Command="{Binding ExportStationsCsvCommand}"
                          ToolTip="Station coordinates in the PC plan frame (GIS-friendly)" />
                <MenuItem Header="_Registry (caves + catalog) → CSV" Command="{Binding ExportRegistryCsvCommand}" />
                <MenuItem Header="Maps _report → CSV" Command="{Binding ExportMapsReportCommand}"
                          ToolTip="All rows from the Maps tab (JSON/ZIP paths + standalone map files), UTF-8 BOM" />
                <MenuItem Header="_Survey &amp; QC report (TXT)…" Command="{Binding ExportSurveyQcReportCommand}"
                          ToolTip="Project summary + traverse statistics and QC hints (UTF-8 BOM) for the selected cave." />
                <MenuItem Header="Export _all projects to folder…" Command="{Binding ExportAllProjectsToFolderCommand}"
                          ToolTip="For every loaded project: shots CSV; if traverse exists also Survex .svx, Therion .th, stations x,y,z CSV." />
                <Separator />
                <MenuItem Header="Plan → _SVG" Command="{Binding ExportPlanSvgCommand}" />
                <MenuItem Header="Plan → _DXF" Command="{Binding ExportPlanDxfCommand}" />
                <MenuItem Header="Section → SVG" Command="{Binding ExportSectionSvgCommand}" />
                <MenuItem Header="Section → DXF" Command="{Binding ExportSectionDxfCommand}" />
                <Separator />
                <MenuItem Header="_Extract photos (ZIP)" Command="{Binding ExtractPhotosCommand}" />
                <MenuItem Header="Extract _full archive (ZIP)…" Command="{Binding ExtractFullArchiveCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Compare two backups…" Command="{Binding CompareBackupsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" InputGestureText="F1" />
                <MenuItem Header="_Keyboard shortcuts…" Command="{Binding ShowKeyboardShortcutsCommand}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource Cave.Surface}">
            <ToolBar ToolBarTray.IsLocked="True" Background="Transparent">
                <Image Width="32" Height="32" Margin="0,0,10,0" Stretch="Uniform"
                       Source="pack://application:,,,/Assets/ic_launcher_logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="CAVE AI PRO" />
                <Button Content="Open" Command="{Binding OpenFileCommand}" Padding="12,6" Margin="0,0,6,0"
                        Style="{StaticResource Cave.AccentButton}" />
                <Separator />
                <Button Content="CSV" Command="{Binding ExportCsvCommand}" ToolTip="Export shots CSV" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Survex" Command="{Binding ExportSurvexCommand}" ToolTip="Export traverse .svx" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Therion" Command="{Binding ExportTherionCommand}" ToolTip="Export traverse .th" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Photos" Command="{Binding ExtractPhotosCommand}" ToolTip="Extract photos from ZIP" Padding="10,6" Margin="0,0,4,0" />
                <Button Content="Explorer" Command="{Binding RevealCurrentFileInExplorerCommand}" ToolTip="Show current file in Explorer" Padding="10,6" Margin="0,0,4,0" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Cave.Surface}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="780"
                           Foreground="{DynamicResource Cave.TextSubdued}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SourcePathDisplay}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Foreground="{DynamicResource Cave.TextSubdued}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Border Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource Cave.Surface}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Visibility="{Binding ShowIntegrityBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding IntegrityBannerText}" TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{Binding IntegrityBannerColorHex, Converter={StaticResource HexToBrush}}" />
                </Border>
                <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource Cave.BannerTint}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Visibility="{Binding ShowSchemaNote, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SchemaNoteText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Cave.TextSubdued}" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Recent files" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Cave.Text}" />
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,8,0,0"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="0,1,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextSubdued}" FontSize="11"
                                   Text="Phone: CaveAI Pro from Google Play → Settings / backup → ZIP under Downloads/CaveAI, or copy caveai_database_v1.json. This PC app (x64) is not from Play." />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4" Padding="6,4" HorizontalContentAlignment="Left"
                                            Content="{Binding}"
                                            Command="{Binding DataContext.OpenRecentCommand, ElementName=Shell}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Projects" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Cave.Text}" />
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Cave.TextMuted}" FontSize="12" />
                            <TextBox Text="{Binding ProjectListFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                     ToolTip="Filter by cave name or survey date"
                                     Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                     BorderBrush="{DynamicResource Cave.Border}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Text="After opening a backup, click a cave in the list — Plan, Section, and Maps stay empty until a project is selected." />
                        <ListBox ItemsSource="{Binding ProjectsForList}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}"
                                 Foreground="{DynamicResource Cave.Text}" />
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />

                    <Grid Grid.Column="2">
                        <TabControl Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}"
                                    Padding="0,2,0,0">
                        <TabItem Header="Summary">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,4">
                                    <Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Padding="10,5"
                                            ToolTip="Copy the text summary to the clipboard" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                                    <TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" Foreground="{DynamicResource Cave.Text}"
                                             BorderThickness="0" Background="Transparent" Padding="0" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Backup detail">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="160" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="220" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource Cave.TextMuted}" FontSize="12"
                                               Text="Full scan of raw data.json: per cave — traverse legs, photo and audio URI counts, rocks, field catalog, vectorLines, public cartography list, LIDAR / TLS fields, surveyEventLog size, and every top-level JSON key. Multiple opened files are listed one after another." />
                                    <TextBox Text="{Binding BackupDataAnalyticsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="12" Padding="8"
                                             Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                             BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" />
                                </DockPanel>
                                <GridSplitter Grid.Row="1" Style="{StaticResource Cave.GridSplitterHorizontal}" />
                                <DockPanel Grid.Row="2">
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource Cave.TextMuted}" FontSize="12"
                                               Text="map_inventory.json (Android ZIP): cartography paths per cave. Older archives may still list legacy traverse rows; new exports are cartography-only." />
                                    <DataGrid ItemsSource="{Binding MapInventoryRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ZIP file" Binding="{Binding SourceZip}" Width="130" />
                                            <DataGridTextColumn Header="Cave" Binding="{Binding ProjectName}" Width="120" />
                                            <DataGridTextColumn Header="Date" Binding="{Binding ProjectDate}" Width="100" />
                                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="200" />
                                            <DataGridTextColumn Header="Path in backup / URL" Binding="{Binding PathInBackupOrUrl}" Width="2*" />
                                            <DataGridTextColumn Header="Storage kind" Binding="{Binding StorageKind}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Plan">
                            <views:PlanView Project="{Binding SelectedProject, ElementName=Shell}"
                                            ZipPath="{Binding ActiveZipPathForMaps, ElementName=Shell}"
                                            MapRows="{Binding MapAssetRows, ElementName=Shell}"
                                            MapInventory="{Binding MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="Maps">
                            <DockPanel LastChildFill="True" Margin="10">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Export _report (CSV)…"
                                            Command="{Binding ExportMapsReportCommand}" Padding="10,5" Margin="12,0,0,0"
                                            ToolTip="Save a full UTF-8 BOM CSV (cartography + traverse photo/audio paths + standalone maps)"
                                            VerticalAlignment="Top" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextSubdued}"
                                               Text="Cartography-focused list: library rasters, LiDAR, mesh, sketches, symbols, etc. — traverse station photos and audio are omitted here (use Export report (CSV) for a full path audit including photos/). Plan/Section use the first resolvable raster. Open (or double-click), copy, Explorer, or Extract… for local files, ZIP entries, or cached https rasters." />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding MapAssetRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding OpenMapAssetCommand}"
                                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120" />
                                        <DataGridTextColumn Header="Map label" Binding="{Binding DetailLabel}" Width="3*" />
                                        <DataGridTextColumn Header="Map type" Binding="{Binding MapTypeLabel}" Width="160" />
                                        <DataGridTextColumn Header="JSON field" Binding="{Binding Category}" Width="160" />
                                        <DataGridTextColumn Header="URI / path" Binding="{Binding UriOrPath}" Width="2*" />
                                        <DataGridTextColumn Header="Source file" Binding="{Binding SourceFile}" Width="*" />
                                        <DataGridTemplateColumn Header="Actions" MinWidth="228">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical" Margin="0,2">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Button Content="Open" Padding="8,2" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.OpenMapAssetCommand, ElementName=Shell}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="Copy" Padding="8,2"
                                                                    Command="{Binding DataContext.CopyMapUriCommand, ElementName=Shell}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Explorer" Padding="8,2" Margin="0,0,6,0"
                                                                    ToolTip="Show in File Explorer (local file or extract from ZIP to temp)"
                                                                    Command="{Binding DataContext.RevealMapAssetInExplorerCommand, ElementName=Shell}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="Extract…" Padding="8,2"
                                                                    ToolTip="Save a local copy (ZIP entry, file next to .json, or cached https raster)"
                                                                    Command="{Binding DataContext.ExtractMapAssetToDiskCommand, ElementName=Shell}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Section">
                            <views:SectionView Project="{Binding SelectedProject, ElementName=Shell}"
                                               ZipPath="{Binding ActiveZipPathForMaps, ElementName=Shell}"
                                               MapRows="{Binding MapAssetRows, ElementName=Shell}"
                                               MapInventory="{Binding MapInventoryRows, ElementName=Shell}" />
                        </TabItem>
                        <TabItem Header="QC / stats">
                            <DockPanel LastChildFill="True" Margin="10">
                                <ScrollViewer DockPanel.Dock="Top" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                    <TextBox Text="{Binding StatisticsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Cave.Text}"
                                             BorderThickness="0" Background="Transparent" />
                                </ScrollViewer>
                                <TextBlock DockPanel.Dock="Top" Text="Stations (traverse reduction)" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Cave.TextMuted}" />
                                <DataGrid ItemsSource="{Binding StationQcRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Station" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="X m" Binding="{Binding X, StringFormat=F2}" Width="72" />
                                        <DataGridTextColumn Header="Y m" Binding="{Binding Y, StringFormat=F2}" Width="72" />
                                        <DataGridTextColumn Header="Z m" Binding="{Binding Z, StringFormat=F2}" Width="72" />
                                        <DataGridTextColumn Header="From-legs" Binding="{Binding TraverseLegsFrom}" Width="72" />
                                        <DataGridTextColumn Header="To-legs" Binding="{Binding TraverseLegsTo}" Width="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Shots">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                                    <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                    <TextBox Text="{Binding ShotsFilterText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                             Background="{DynamicResource Cave.Surface}" Foreground="{DynamicResource Cave.Text}"
                                             BorderBrush="{DynamicResource Cave.Border}" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding ShotsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="From" Binding="{Binding FromStation}" Width="*" />
                                    <DataGridTextColumn Header="To" Binding="{Binding ToStation}" Width="*" />
                                    <DataGridTextColumn Header="Dist m" Binding="{Binding Distance, StringFormat=F2}" Width="72" />
                                    <DataGridTextColumn Header="Clino°" Binding="{Binding Clino}" Width="56" />
                                    <DataGridTextColumn Header="Az°" Binding="{Binding Azimuth}" Width="56" />
                                    <DataGridTextColumn Header="Depth m" Binding="{Binding Depth, StringFormat=F2}" Width="72" />
                                    <DataGridTextColumn Header="L" Binding="{Binding L, StringFormat=F2}" Width="44" />
                                    <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=F2}" Width="44" />
                                    <DataGridTextColumn Header="U" Binding="{Binding U, StringFormat=F2}" Width="44" />
                                    <DataGridTextColumn Header="D" Binding="{Binding D, StringFormat=F2}" Width="44" />
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Catalog">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="140" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="1.25*" MinHeight="180" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Personal Cave Library — same KnownCave catalog as CaveAI Pro Android (cave_library.json inside the backup ZIP, or open that JSON file alone)." />
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="Library filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding KnownCaveCatalogFilter, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                                        </DockPanel>
                                        <views:KnownCaveLibraryCardsPanel />
                                        <Separator Margin="0,14,0,12" />
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Surveys in the loaded backup(s) — one card per project in data.json; click to open in the list." />
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="Survey filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding RegistryCaveFilter, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                                        </DockPanel>
                                        <views:CaveLibraryCardsPanel />
                                    </StackPanel>
                                </ScrollViewer>
                                <GridSplitter Grid.Row="1" Style="{StaticResource Cave.GridSplitterHorizontal}" />
                                <DockPanel Grid.Row="2">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Biota &amp; minerals — rocks + fieldCatalogEntries (species/mineral/photo columns when present in JSON)." />
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding RegistryBioFilter, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                                        </DockPanel>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding BioMineralCatalogRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cave" Binding="{Binding CaveName}" Width="160" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" />
                                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.2*" />
                                            <DataGridTextColumn Header="Species" Binding="{Binding Species}" Width="100" />
                                            <DataGridTextColumn Header="Mineral" Binding="{Binding Mineral}" Width="100" />
                                            <DataGridTextColumn Header="Photo/URI" Binding="{Binding PhotoUri}" Width="120" />
                                            <DataGridTextColumn Header="Coords" Binding="{Binding CoordinatesSummary}" Width="100" />
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Archive">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="backup_manifest.json" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Cave.TextMuted}" />
                                <TextBox Grid.Row="1" Text="{Binding BackupManifestSummary, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Padding="8" Background="{DynamicResource Cave.Surface}"
                                         Foreground="{DynamicResource Cave.Text}" FontFamily="Consolas" FontSize="12"
                                         BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6">
                                    <Button Content="Show file in Explorer" Command="{Binding RevealCurrentFileInExplorerCommand}" Padding="10,5" Margin="0,0,8,0"
                                            ToolTip="Select the open backup (.zip or .json) in File Explorer" />
                                    <Button Content="Open last full extract" Command="{Binding OpenLastExtractedFolderCommand}" Padding="10,5"
                                            ToolTip="Opens the folder from the last “Extract full archive” run in this session" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="{Binding ArchiveListHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Cave.TextMuted}" FontSize="12" />
                                <ListView Grid.Row="4" ItemsSource="{Binding ZipArchiveEntries}" SelectedItem="{Binding SelectedZipEntry, Mode=TwoWay}"
                                          Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}"
                                          Foreground="{DynamicResource Cave.Text}" FontFamily="Consolas" FontSize="12">
                                    <ListView.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenSelectedZipEntryCommand}" />
                                    </ListView.InputBindings>
                                    <ListView.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="_Open (extract to temp)" Command="{Binding OpenSelectedZipEntryCommand}" />
                                            <MenuItem Header="_Extract to…" Command="{Binding ExtractSelectedZipEntryToDiskCommand}" />
                                            <MenuItem Header="_Copy path in archive" Command="{Binding CopySelectedZipEntryPathCommand}" />
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Bytes" Width="100" DisplayMemberBinding="{Binding SizeDisplay}" />
                                            <GridViewColumn Header="Path in ZIP" Width="520" DisplayMemberBinding="{Binding ArchiveRelativePath}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Integrity">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <TextBox Text="{Binding IntegrityDetailText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource Cave.Text}"
                                         FontFamily="Consolas" />
                            </ScrollViewer>
                        </TabItem>
                        </TabControl>

                        <Border Panel.ZIndex="2"
                                Background="{DynamicResource Cave.Background}"
                                Opacity="0.96"
                                CornerRadius="8"
                                Margin="0,4,0,0"
                                Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
                                <TextBlock Text="CAVE AI PRO" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource Cave.TextMuted}"
                                           Text="Open a backup from CaveAI Pro on Android: a .json database or a full .zip (with data.json). Drag and drop files here, or use Open." />
                                <Button Content="Open backup…" Command="{Binding OpenFileCommand}"
                                        Style="{StaticResource Cave.AccentButton}" HorizontalAlignment="Center"
                                        Padding="20,10" Margin="0,20,0,0" FontSize="14" />
                                <TextBlock Text="Ctrl+O · F1 About · Help → Keyboard shortcuts" FontSize="12"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextAlignment="Center"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

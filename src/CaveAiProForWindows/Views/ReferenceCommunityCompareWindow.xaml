<Window x:Class="CaveAiProForWindows.Views.ReferenceCommunityCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference vs community compare"
        Height="560" Width="880"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10"
                   Text="Compare a reference catalog cave with a published survey on this PC (or two reference entries). Mirrors the web ReferenceCommunityCompare panel." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Auto-link active project" Padding="12,6" Margin="0,0,8,0"
                    Click="AutoLinkActiveProject_Click"
                    ToolTip="Match selected main-window project to reference catalog by GPS/name" />
            <Button Content="Compare active vs reference link" Padding="12,6" Margin="0,0,8,0"
                    Click="CompareActiveProjectLink_Click"
                    ToolTip="Compare the selected project in the main window with its referenceCatalogLink metadata" />
            <Button Content="Compare on Explore terrain" Padding="12,6" Margin="0,0,8,0" Click="CompareOnExploreTerrain_Click" ToolTip="Frame both reference selections on caveaipro.com Explore terrain (WebView2)" />
            <Button Content="Compare" Padding="12,6" Margin="0,0,8,0" Click="Compare_Click" IsDefault="True" />
            <Button Content="Close" Padding="12,6" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Reference A" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="RefSearchA" Padding="8,6" Margin="0,0,0,6" ToolTip="Search reference catalog by name" />
                <ListBox x:Name="RefListA" DisplayMemberPath="Name" Height="140" SelectionChanged="RefListA_SelectionChanged" />
                <TextBlock Text="Or published survey on this PC" Margin="0,10,0,6" Foreground="{DynamicResource Cave.TextMuted}" />
                <ComboBox x:Name="SurveyComboA" Padding="6,4" SelectionChanged="SurveyComboA_SelectionChanged" />
            </StackPanel>
            <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />
            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="Reference B (optional)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="RefSearchB" Padding="8,6" Margin="0,0,0,6" />
                <ListBox x:Name="RefListB" DisplayMemberPath="Name" Height="140" SelectionChanged="RefListB_SelectionChanged" />
                <TextBlock Text="Or published survey" Margin="0,10,0,6" Foreground="{DynamicResource Cave.TextMuted}" />
                <ComboBox x:Name="SurveyComboB" Padding="6,4" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="8" BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Cave.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,6,0" Background="#FF101820" CornerRadius="4" MinHeight="100">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Plan A" FontSize="10" Margin="4,2" Foreground="#FF8B95A8" />
                        <Image x:Name="PlanPreviewImage" Stretch="Uniform" Margin="4"
                               ToolTip="Plan preview for side A (reference pin or published survey)" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Margin="6,0,0,0" Background="#FF101820" CornerRadius="4" MinHeight="100">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Plan B / overlay" FontSize="10" Margin="4,2" Foreground="#FF8B95A8" />
                        <Image x:Name="PlanPreviewImageB" Stretch="Uniform" Margin="4"
                               ToolTip="Plan preview for side B or linked community survey" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource Cave.TextMuted}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>

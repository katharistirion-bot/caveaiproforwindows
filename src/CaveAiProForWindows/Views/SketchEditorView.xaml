<UserControl x:Class="CaveAiProForWindows.Views.SketchEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CaveAiProForWindows.Converters"
             Background="{DynamicResource Cave.Background}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tool sidebar: drawing mode + symbols + view options -->
        <Border Grid.Column="0" Margin="0,0,10,0" Padding="0" CornerRadius="6"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                Background="{DynamicResource Cave.Surface}"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <StackPanel Margin="5">
                    <TextBlock Text="Drawing mode" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,8" />
                    <RadioButton x:Name="SketchToolPan" GroupName="SketchEditorTools" IsChecked="True"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Pan / zoom" Checked="SketchToolPan_Checked"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <RadioButton x:Name="SketchToolSelect" GroupName="SketchEditorTools"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Select" Checked="SketchToolSelect_Checked"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <RadioButton x:Name="SketchToolDraw" GroupName="SketchEditorTools"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Freehand draw" Checked="SketchToolDraw_Checked"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <RadioButton x:Name="SketchToolLine" GroupName="SketchEditorTools"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Straight line" Checked="SketchToolLine_Checked"
                                 ToolTip="Drag a straight wall or passage segment (Ctrl+6)"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <RadioButton x:Name="SketchToolSymbol" GroupName="SketchEditorTools"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Insert symbol" Checked="SketchToolSymbol_Checked"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <RadioButton x:Name="SketchToolErase" GroupName="SketchEditorTools"
                                 FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                 Content="Erase" Checked="SketchToolErase_Checked"
                                 Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />

                    <TextBlock Text="Ink style" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                        <ComboBox x:Name="InkStrokeWidthCombo" Width="72" SelectedIndex="1"
                                  SelectionChanged="InkStrokeStyle_Changed"
                                  ToolTip="Stroke width for freehand and line tools">
                            <ComboBoxItem Content="1" Tag="1" />
                            <ComboBoxItem Content="1.5" Tag="1.5" />
                            <ComboBoxItem Content="2" Tag="2" />
                            <ComboBoxItem Content="3" Tag="3" />
                            <ComboBoxItem Content="4" Tag="4" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="InkDashedStrokesCheck" Margin="0,0,0,6"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              Content="Dashed strokes"
                              ToolTip="Dashed lines for generic ink (when Line kind = Generic ink)"
                              Checked="InkStrokeStyle_Changed" Unchecked="InkStrokeStyle_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Line kind" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                        <ComboBox x:Name="InkWallProfileCombo" Width="118" SelectedIndex="0"
                                  SelectionChanged="InkWallProfile_Changed"
                                  ToolTip="UIS wall semantics: solid wall, estimated (dashed), sand/clay boundary, or generic ink">
                            <ComboBoxItem Content="Passage wall" Tag="wall" />
                            <ComboBoxItem Content="Estimated wall" Tag="wall_estimated" />
                            <ComboBoxItem Content="Sand/clay edge" Tag="fill_boundary" />
                            <ComboBoxItem Content="Generic ink" Tag="ink" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="Edit" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,6" />
                    <StackPanel x:Name="SketchEditToolsPanel" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Undo" Padding="10,6" Margin="0,0,6,0"
                                Command="{Binding UndoCommand}"
                                ToolTip="Undo last sketch edit (Ctrl+Z)" />
                        <Button Content="Redo" Padding="10,6"
                                Command="{Binding RedoCommand}"
                                ToolTip="Redo (Ctrl+Y)" />
                    </StackPanel>
                    <CheckBox x:Name="SketchSnapToStationsCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              Content="Snap to stations"
                              ToolTip="When drawing lines or freehand, snap endpoints to nearby traverse stations"
                              Checked="SketchSnapToStations_Changed" Unchecked="SketchSnapToStations_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <TextBlock Text="Design layer" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Select all ink" Padding="8,6" Margin="0,0,6,0"
                                Click="SketchSelectAllInk_Click"
                                ToolTip="Select the topmost sketch stroke or symbol (shows layer count in status bar)" />
                        <Button Content="Fit survey" Padding="8,6" Margin="0,0,6,0"
                                Click="SketchFitSurvey_Click"
                                ToolTip="Zoom/pan to frame traverse bounds (Ctrl+F)" />
                        <Button Content="Duplicate" Padding="8,6" Margin="0,0,6,0"
                                Click="SketchDuplicateInk_Click"
                                ToolTip="Duplicate selected ink (Ctrl+D)" />
                        <Button Content="Clear all" Padding="8,6"
                                Click="SketchClearAllInk_Click"
                                ToolTip="Remove all user sketch ink from the design layer" />
                    </StackPanel>
                    <Button Content="Export plan PNG…" Margin="0,0,0,10" Padding="10,6"
                            FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                            Click="SketchExportPng_Click"
                            ToolTip="Save high-res plan cartography with sketch overlay to PNG" />

                    <TextBlock Text="Map zoom" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="SketchZoomOutBtn" Content="−" Width="36" Height="32" Padding="0"
                                FontSize="18" FontWeight="SemiBold"
                                ToolTip="Zoom out (mouse wheel down toward cursor)" Click="SketchZoomOut_Click" />
                        <Button x:Name="SketchZoomInBtn" Content="+" Width="36" Height="32" Margin="8,0,0,0"
                                Padding="0" FontSize="18" FontWeight="SemiBold"
                                ToolTip="Zoom in (mouse wheel up toward cursor)" Click="SketchZoomIn_Click" />
                    </StackPanel>

                    <Separator Margin="0,0,0,10" />

                    <TextBlock Text="Sketch symbols" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,8" />

                    <Border x:Name="SymbolPaletteRoot" IsEnabled="False" Padding="6"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" CornerRadius="4"
                            Background="{DynamicResource Cave.CanvasBackdrop}">
                        <WrapPanel HorizontalAlignment="Center" MaxWidth="190">
                            <ToggleButton x:Name="SymbolPaletteRock" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Rock / block" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked"
                                          Content="{DynamicResource SketchGlyphRock}" />
                            <ToggleButton x:Name="SymbolPaletteWater" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Water / pool" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked"
                                          Content="{DynamicResource SketchGlyphWater}" />
                            <ToggleButton x:Name="SymbolPaletteSpele" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Stalactite / speleothem" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked"
                                          Content="{DynamicResource SketchGlyphSpele}" />
                            <ToggleButton x:Name="SymbolPaletteFlow" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Flowstone / curtain" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Fl" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteSand" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Sand / mud floor" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Sd" FontSize="11" />
                            <ToggleButton x:Name="SymbolPalettePit" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Shaft / pit" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Pt" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteAid" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Rope / ladder / fixed aid" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Ld" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteChoke" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Choke / constriction" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Ch" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteBreakdown" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Breakdown / boulder pile" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Br" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteColumn" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Column / pillar" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Co" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteHelictite" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Helictite / eccentric speleothem (UIS helictite)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="He" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteAven" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Aven / shaft up (UIS aven)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Av" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteStream" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Subterranean stream (UIS stream)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Sr" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteMud" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Mud deposit (UIS mud)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Md" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteArchaeology" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Bones / archaeology (UIS bones)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Ar" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteGuano" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Bat guano (UIS guano)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Bn" FontSize="11" />
                            <ToggleButton x:Name="SymbolPaletteCrack" Width="40" Height="36" Margin="0,0,4,4"
                                          ToolTip="Crack / fissure (estimated passage edge)" Padding="2" Background="Transparent"
                                          BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                          Checked="SymbolPalette_Checked" Content="Cr" FontSize="11" />
                        </WrapPanel>
                    </Border>

                    <Expander Header="UIS symbol legend" IsExpanded="False" Margin="0,0,0,10">
                        <ItemsControl x:Name="SymbolLegendList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3"
                                               FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="Keyboard shortcuts" IsExpanded="False" Margin="0,0,0,10">
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Text="W — straight line · Delete — remove selected ink · Ctrl+D duplicate · Ctrl+F fit survey · Ctrl+Z/Y undo/redo&#x0a;Ctrl+1 Pan · 2 Select · 3 Draw · 4 Symbol · 5 Erase · 6 Line · Wheel zoom · double-click reset view." />
                    </Expander>

                    <Separator Margin="0,0,0,10" />

                    <Expander Header="Survey display" IsExpanded="True" Margin="0,0,0,6">
                        <StackPanel Margin="0,6,0,0">
                    <CheckBox x:Name="SketchStationNamesCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Station names"
                              ToolTip="Label each traverse station"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchStationZDepthCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              Content="Show Z (elevation)" ToolTip="Plan-frame Z (m) beside each station"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchLegSurveyDetailsCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Leg distances &amp; angles"
                              ToolTip="Tape length, azimuth, clino, dZ, and LRUD on each traverse leg"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchStationEnvironmentCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Station environment"
                              ToolTip="Temperature, humidity, O₂, CO₂, pressure at stations"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchDepthSpanAnnotationsCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Depth span callouts"
                              ToolTip="User depth braces from depthSpanAnnotations"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchBracketMarkersCheck" Margin="0,0,0,8"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Bracket markers"
                              ToolTip="Description and temperature pins from brackets"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                    <CheckBox x:Name="SketchCartographyOverlayCheck" Margin="0,0,0,0"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              IsChecked="True" Content="Scale bar &amp; survey compass"
                              ToolTip="Scale bar and +Y compass (bottom-right of map)"
                              Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                              Foreground="{DynamicResource Cave.Text}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="Map cartography style" FontWeight="SemiBold"
                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                               Foreground="{DynamicResource Cave.Text}"
                               Margin="0,0,0,8" />
                    <ComboBox x:Name="CartographicIntensityCombo" Margin="0,0,0,10"
                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                              SelectionChanged="CartographicIntensityCombo_SelectionChanged"
                              ToolTip="Subtle: lighter grid &amp; shadow · Balanced · Rich: stronger sketch depth (saved for all map tabs)">
                        <ComboBoxItem Content="Subtle" Tag="Subtle" />
                        <ComboBoxItem Content="Balanced" Tag="Balanced" />
                        <ComboBoxItem Content="Rich" Tag="Rich" />
                    </ComboBox>

                    <Separator Margin="0,4,0,10" />

                    <Expander Header="Procedural Assist" IsExpanded="False" Margin="0,0,0,6">
                    <StackPanel x:Name="ProceduralAssistPanel" Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Margin="0,0,0,8"
                                   Text="Auto-draw LRUD wall outlines and place survey/catalog symbols on the design layer from traverse data." />
                        <CheckBox Content="LRUD wall outlines" Margin="0,0,0,6"
                                  FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                  IsChecked="{Binding IncludeWallOutlines}"
                                  Foreground="{DynamicResource Cave.Text}" />
                        <CheckBox Content="Map symbols" Margin="0,0,0,6"
                                  FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                  IsChecked="{Binding IncludeMapSymbols}"
                                  Foreground="{DynamicResource Cave.Text}" />
                        <CheckBox Content="Field catalog pins" Margin="0,0,0,6"
                                  FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                  IsChecked="{Binding IncludeFieldCatalogPins}"
                                  Foreground="{DynamicResource Cave.Text}" />
                        <CheckBox Content="Splay leg outlines" Margin="0,0,0,8"
                                  FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                  IsChecked="{Binding IncludeSplayOutlines}"
                                  ToolTip="LRUD / radial splay segments as dashed estimated-wall preview (UIS wall_estimated)"
                                  Foreground="{DynamicResource Cave.Text}" />
                        <Button Content="Generate from survey" Margin="0,0,0,6" Padding="10,8"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Style="{StaticResource Cave.AccentButton}"
                                Command="{Binding GenerateProceduralCommand}" />
                        <Button Content="Accept procedural" Margin="0,0,0,6" Padding="10,6"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Command="{Binding AcceptProceduralCommand}" />
                        <Button Content="Clear procedural" Margin="0,0,0,6" Padding="10,6"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Command="{Binding ClearProceduralCommand}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextSubdued}" />
                    </StackPanel>
                    </Expander>

                    <Separator Margin="0,4,0,10" />

                    <Expander Header="Push to Cloud" IsExpanded="False">
                    <StackPanel x:Name="CloudPublishPanel" Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Margin="0,0,0,8"
                                   Text="Upload plan cartography, structure mask, and enriched survey JSON to your linked Public Cave Library entry. Sign in securely when prompted." />
                        <TextBlock Text="{Binding LinkedCaveIdDisplay}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextSubdued}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ReadinessSummary}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextMuted}"
                                   Margin="0,0,0,8" />
                        <Button Content="Set library link…" Margin="0,0,0,6" Padding="10,6"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Command="{Binding SetLinkedCaveIdCommand}"
                                ToolTip="Set or change the Firestore published_caves document id (?cave= on the web map)" />
                        <Button Content="Push to Cloud" Margin="0,0,0,6" Padding="10,8"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Style="{StaticResource Cave.AccentButton}"
                                Command="{Binding PushToCloudCommand}"
                                ToolTip="Opens secure sign-in, then uploads survey JSON and AI assets to Firestore + Storage" />
                        <Button Content="Sign in…" Margin="0,0,0,8" Padding="10,6"
                                FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                Command="{Binding SignInCommand}"
                                ToolTip="Open secure WebView2 sign-in (Firebase ID token via postMessage)" />

                        <Border Visibility="{Binding ShowOpenLibraryHint, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,8" Padding="8,6" CornerRadius="4"
                                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                Background="{DynamicResource Cave.CanvasBackdrop}">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                       Foreground="{DynamicResource Cave.Accent}"
                                       Text="Sign in with Google in the secure sign-in window when Push to Cloud asks for authentication." />
                        </Border>

                        <ProgressBar Height="8" Margin="0,0,0,6"
                                     Minimum="0" Maximum="100"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Value="{Binding ProgressValue}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextSubdued}"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="#FFE57373"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Cancel publish" Padding="8,5"
                                FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                Command="{Binding CancelPublishCommand}"
                                Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Map + analytical panel -->
        <Border Grid.Column="1" Background="{DynamicResource Cave.CanvasBackdrop}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" CornerRadius="4"
                Padding="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition x:Name="SurveyDetailsColumn" Width="250" MinWidth="230" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="SketchMapHostGrid" Grid.Column="0" ClipToBounds="True"
                      SizeChanged="SketchMapHost_SizeChanged">
                    <ScrollViewer x:Name="HostScroll" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"
                                  PreviewMouseWheel="HostScroll_PreviewMouseWheel">
                        <Grid x:Name="MapZoomRoot" MinWidth="320" MinHeight="240" Width="960" Height="640"
                              ClipToBounds="True"
                              HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" CenterX="480"
                                                    CenterY="320" />
                                    <TranslateTransform x:Name="ZoomPan" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Canvas x:Name="SurveyCanvas" Width="960" Height="640" ClipToBounds="True"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />
                            <Canvas x:Name="DesignLayer" Width="960" Height="640" ClipToBounds="True"
                                    Background="Transparent" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    MouseLeftButtonDown="DesignLayer_MouseLeftButtonDown"
                                    MouseMove="DesignLayer_MouseMove"
                                    MouseLeftButtonUp="DesignLayer_MouseLeftButtonUp"
                                    MouseDown="DesignLayer_MouseDown"
                                    MouseUp="DesignLayer_MouseUp"
                                    MouseLeave="DesignLayer_MouseLeave" />
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="SurveyHudPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="12,12,12,12" Panel.ZIndex="8" Padding="12,10" CornerRadius="6" MaxWidth="280"
                            IsHitTestVisible="False"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                            Background="{DynamicResource Cave.Surface}" Opacity="0.96">
                        <StackPanel>
                            <TextBlock x:Name="HudCaveNameText" FontWeight="Bold"
                                       FontSize="{DynamicResource Cave.HudTitleFontSize}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Cave.Text}" Text="—" />
                            <TextBlock Text="Survey summary" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Cave.TextMuted}" />
                            <TextBlock x:Name="HudStationCountText" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Cave.HudFontSize}"
                                       Foreground="{DynamicResource Cave.TextSubdued}" />
                            <TextBlock x:Name="HudLengthText" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Cave.HudFontSize}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Cave.TextSubdued}" />
                            <TextBlock x:Name="HudZSpanText" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Cave.HudFontSize}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Cave.TextSubdued}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EditorStatusBar" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="12,12,12,12" Panel.ZIndex="9" Padding="10,6" CornerRadius="4" MaxWidth="420"
                            IsHitTestVisible="False"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                            Background="{DynamicResource Cave.Surface}" Opacity="0.94">
                        <TextBlock x:Name="EditorStatusText" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                   Foreground="{DynamicResource Cave.TextSubdued}"
                                   Text="Pan / zoom · Snap off" />
                    </Border>
                </Grid>

                <Border x:Name="SurveyDetailsPane" Grid.Column="1" Margin="8,0,0,0" Padding="12,12" CornerRadius="6"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        VerticalAlignment="Stretch" Background="{DynamicResource Cave.Surface}">
                        <DockPanel LastChildFill="True">
                        <TextBlock x:Name="PropertyPaneTitleText" DockPanel.Dock="Top" FontWeight="SemiBold"
                                   FontSize="{DynamicResource Cave.DetailsTitleFontSize}" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Cave.Text}" TextWrapping="Wrap"
                                   Text="Survey overview" />
                        <Border x:Name="PropertySelectionStatusBadge" DockPanel.Dock="Top" Margin="0,0,0,10"
                                Padding="8,4" CornerRadius="6"
                                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                Background="{DynamicResource Cave.CanvasBackdrop}">
                            <TextBlock x:Name="PropertySelectionStatusText"
                                       FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                       Foreground="{DynamicResource Cave.TextMuted}" TextWrapping="Wrap"
                                       Text="No item selected" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="PropertyNameFieldCaption" Text="Name" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                <TextBlock x:Name="PropertyStationLegNameText" Margin="0,2,0,10"
                                           FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                           Text="-" />

                                <TextBlock x:Name="PropertyCoordsFieldCaption" Text="Plan XY &amp; Z elevation"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                <TextBlock x:Name="PropertyCoordinatesText" Margin="0,2,0,10"
                                           FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                           Text="-" />

                                <TextBlock x:Name="PropertySurveyFieldCaption" Text="Tape · azimuth · clino"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                <TextBlock x:Name="PropertySurveyDataText" Margin="0,2,0,10"
                                           FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                           Text="-" />

                                <TextBlock x:Name="PropertyWallFieldCaption"
                                           Text="Cross-section LRUD (Left · Right · Up · Down)"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                <TextBlock x:Name="PropertyWallDimensionsText" Margin="0,2,0,0"
                                           FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                           Text="-" />

                                <TextBlock Text="Android export (full parsed context)" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}"
                                           Margin="0,14,0,4" />
                                <TextBlock x:Name="PropertyAndroidPayloadText" Margin="0,0,0,0"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                           Text="—" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

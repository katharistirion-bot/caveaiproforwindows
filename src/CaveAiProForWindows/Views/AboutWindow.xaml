<Window x:Class="CaveAiProForWindows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About CAVE AI PRO"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Padding="28,24" MinWidth="360" MaxWidth="440">
        <StackPanel>
            <Image Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,16" Stretch="Uniform"
                   Source="pack://application:,,,/Assets/ic_launcher_logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="TitleBlock" Text="CAVE AI PRO" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="VersionBlock" HorizontalAlignment="Center" Foreground="{DynamicResource Cave.TextMuted}"
                       Margin="0,0,0,16" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Cave.TextMuted}"
                       LineHeight="20"
                       Text="Survey workstation for Windows: same CaveAI Pro (Android) JSON and backup ZIP, with traverse QC, integrity checks, plan/section drawing, and professional exports—Survex, Therion, station coordinates, DXF/SVG, and batch archive of every loaded project. Desktop PC (x64) companion; not from Google Play." />
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Cave.Accent}"
                       LineHeight="20" FontWeight="SemiBold"
                       Text="Ecosystem: (1) Cave Library on Android/Windows — (2) Publish from Android — (3) Public Cave Library on web and Android. Use Help → Public Cave Library for the in-app map, or Open in browser for your default browser." />
            <TextBlock x:Name="WebPortalBlock" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Cave.TextSubdued}" FontSize="11" LineHeight="16" />
            <TextBlock x:Name="RuntimeBlock" Margin="0,14,0,0" FontSize="11" FontFamily="Consolas"
                       TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextSubdued}"
                       HorizontalAlignment="Left" MaxWidth="400" />
            <Button Content="OK" IsDefault="True" Width="100" Margin="0,22,0,0" HorizontalAlignment="Center"
                    Padding="16,8" Click="Ok_Click" />
        </StackPanel>
    </Border>
</Window>

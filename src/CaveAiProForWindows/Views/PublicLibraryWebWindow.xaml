<Window x:Class="CaveAiProForWindows.Views.PublicLibraryWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Public Cave Library — CaveAI Pro"
        Height="780"
        Width="1180"
        MinHeight="520"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/logo.ico">
    <DockPanel Margin="8">
        <ToolBar DockPanel.Dock="Top" Background="{DynamicResource Cave.Surface}" Padding="4,2">
            <Button Content="← Back" Click="Back_Click" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Open in browser" Click="External_Click" Padding="10,5" Margin="0,0,6,0"
                    ToolTip="Open the same page in your default browser" />
            <Button Content="Download as backup…" Click="DownloadBackup_Click" Padding="10,5" Margin="0,0,6,0"
                    ToolTip="Fetch surveyJsonUrl + cartography assets for the cave open on this page" />
            <Separator />
            <TextBlock x:Name="GuestLibraryHint"
                       VerticalAlignment="Center" Foreground="{DynamicResource Cave.TextMuted}"
                       Text="Sign in with Google to browse caves · same catalog as Android &amp; web" />
        </ToolBar>
        <Border x:Name="GuestLibraryBanner" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="GuestLibraryHeading" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Sign in with Google to unlock the cave map" />
                <TextBlock x:Name="GuestLibraryLead" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Cave.TextMuted}"
                           Text="The basemap stays visible. Reference pins, community surveys, and Explore overlays load after you sign in with the Google account linked to CaveAI Pro on Android." />
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <wv2:WebView2 x:Name="LibraryWebView" />
        </Border>
    </DockPanel>
</Window>

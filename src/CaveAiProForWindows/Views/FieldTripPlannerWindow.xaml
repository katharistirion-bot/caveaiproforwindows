<Window x:Class="CaveAiProForWindows.Views.FieldTripPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Field Trip Planner"
        Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Plan cave visits from the reference catalog — export GPX/KML or open Google Maps directions."
                   TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="OfflineCacheCheck" Content="Offline tile cache" IsChecked="True"
                          Margin="0,0,16,4" Foreground="{DynamicResource Cave.TextSubdued}"
                          ToolTip="Cache OSM / hillshade / DEM tiles on disk (shared with Surface Map)" />
                <CheckBox x:Name="CacheOnlyCheck" Content="Cache only (no network tiles)"
                          Margin="0,0,16,4" Foreground="{DynamicResource Cave.TextSubdued}"
                          ToolTip="Airplane mode after Download offline area" />
                <TextBlock x:Name="TileCacheSizeText" VerticalAlignment="Center" Margin="0,0,12,4"
                           FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Text="Cache: —" />
                <Button x:Name="DownloadOfflineAreaButton" Content="Download offline area" Padding="8,4" Margin="0,0,8,4"
                        Click="DownloadOfflineArea_Click"
                        ToolTip="Prefetch OSM + hillshade + DEM around the first stop (or GPS)" />
                <Button x:Name="CancelOfflineDownloadButton" Content="Cancel" Padding="8,4" Margin="0,0,8,4"
                        Click="CancelOfflineDownload_Click" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="OfflinePackStatusText" FontSize="11" Margin="0,0,0,8"
                       Foreground="{DynamicResource Cave.TextMuted}" Text="Offline pack: none yet" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open Google Maps" Padding="12,6" Margin="0,0,8,0" Click="OpenGoogleMaps_Click" />
            <Button Content="Export GPX…" Padding="12,6" Margin="0,0,8,0" Click="ExportGpx_Click" />
            <Button Content="Export KML…" Padding="12,6" Margin="0,0,8,0" Click="ExportKml_Click" />
            <Button Content="Export PDF…" Padding="12,6" Margin="0,0,8,0" Click="ExportPdf_Click" />
            <Button Content="Copy text summary" Padding="12,6" Margin="0,0,8,0" Click="CopySummary_Click" />
            <Button Content="Copy share link" Padding="12,6" Margin="0,0,8,0" Click="CopyShareLink_Click" />
            <Button Content="Import from link…" Padding="12,6" Margin="0,0,8,0" Click="ImportShareLink_Click" />
            <Button Content="Open on web" Padding="12,6" Margin="0,0,8,0" Click="OpenShareOnWeb_Click" />
            <Button Content="Preview on Explore terrain" Padding="12,6" Margin="0,0,8,0" Click="PreviewOnExploreTerrain_Click"
                    ToolTip="Open field trip stops on caveaipro.com Explore terrain in the in-app Public Library map" />
            <Button Content="Close" Padding="12,6" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="New" Padding="10,5" Margin="0,0,6,0" Click="NewTrip_Click" />
                    <Button Content="Delete" Padding="10,5" Click="DeleteTrip_Click" />
                </StackPanel>
                <ListBox x:Name="TripsList" DisplayMemberPath="Name" SelectionChanged="TripsList_SelectionChanged" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Style="{StaticResource Cave.GridSplitterVertical}" />
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="TripNameBox" Padding="8,6" Margin="0,0,0,6" />
                    <TextBox x:Name="TripNotesBox" Padding="8,6" Height="60" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="Trip notes" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Move up" Padding="10,5" Margin="0,0,6,0" Click="MoveUp_Click" />
                    <Button Content="Move down" Padding="10,5" Margin="0,0,6,0" Click="MoveDown_Click" />
                    <Button Content="Remove stop" Padding="10,5" Margin="0,0,12,0" Click="RemoveStop_Click" />
                    <TextBox x:Name="CommunityStopInput" Width="220" Padding="8,5" Margin="0,0,6,0"
                             ToolTip="Paste community doc id, map?cave= URL, field trip share URL, or reference share URL" />
                    <Button Content="Add community stop" Padding="10,5" Click="AddCommunityStop_Click" />
                </StackPanel>
                <ListBox x:Name="StopsList" DisplayMemberPath="Name" SelectionChanged="StopsList_SelectionChanged" />
                <Border Margin="0,10,0,0" Padding="8" CornerRadius="6" MinHeight="160"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Background="{DynamicResource Cave.CanvasBackdrop}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Stops map preview (MapLibre / OSM)" FontWeight="SemiBold"
                                   FontSize="11.5" Margin="0,0,0,6" Foreground="{DynamicResource Cave.TextMuted}" />
                        <Grid MinHeight="120">
                            <wv2:WebView2 x:Name="StopsMapWebView" />
                            <Border x:Name="StopsMapLoadingOverlay" Background="#CC0D1117" Padding="16"
                                    Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Margin="0,0,0,10" />
                                    <TextBlock x:Name="StopsMapPlaceholder" Text="Initializing map…"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Cave.TextMuted}" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

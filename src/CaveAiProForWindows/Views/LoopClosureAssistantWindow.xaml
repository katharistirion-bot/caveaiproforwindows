<Window x:Class="CaveAiProForWindows.Views.LoopClosureAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loop closure assistant"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10"
                   Text="Detected closed traverse loops with misclosure. Use Compass rule adjustment from the analysis coordinator when ready to distribute error." />
        <DataGrid x:Name="LoopGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stations" Binding="{Binding StationPath}" Width="2*" />
                <DataGridTextColumn Header="Close at" Binding="{Binding SuggestedClosePoint}" Width="80" />
                <DataGridTextColumn Header="Closing leg" Binding="{Binding ClosingLeg}" Width="100" />
                <DataGridTextColumn Header="Misclosure (m)" Binding="{Binding MisclosureMeters}" Width="110" />
                <DataGridTextColumn Header="Total leg (m)" Binding="{Binding TotalLegLength}" Width="100" />
                <DataGridTextColumn Header="Suggestion" Binding="{Binding Suggestion}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window x:Class="CaveAiProForWindows.Views.LoopClosureAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loop closure assistant"
        Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="PreviewSummaryText" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Method:" />
                <ComboBox x:Name="MethodBox" Width="180" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Compass rule (Bowditch)" />
                    <ComboBoxItem Content="Weighted least squares" />
                </ComboBox>
                <Button Content="Preview adjustment" Padding="12,5" Margin="0,0,8,0" Click="Preview_Click" />
                <Button x:Name="ApplyInPlaceButton" Content="Apply to _project" Padding="12,5" Margin="0,0,8,0"
                        Click="ApplyInPlace_Click"
                        ToolTip="Apply plan station overrides to the open project and save (requires writable backup on disk)" />
                <Button Content="Apply to copy…" Padding="12,5" Click="ApplyCopy_Click" />
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10"
                   Text="Detected closed traverse loops with misclosure. Preview is non-destructive. Apply to project writes plan station overrides into the open backup (Ctrl+S) — raw shots unchanged. Apply to copy saves a new ZIP instead." />
        <DataGrid x:Name="LoopGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stations" Binding="{Binding StationPath}" Width="2*" />
                <DataGridTextColumn Header="Close at" Binding="{Binding SuggestedClosePoint}" Width="80" />
                <DataGridTextColumn Header="Closing leg" Binding="{Binding ClosingLeg}" Width="100" />
                <DataGridTextColumn Header="Misclosure (m)" Binding="{Binding MisclosureMeters}" Width="110" />
                <DataGridTextColumn Header="Total leg (m)" Binding="{Binding TotalLegLength}" Width="100" />
                <DataGridTextColumn Header="Suggestion" Binding="{Binding Suggestion}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

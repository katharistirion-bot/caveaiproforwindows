<UserControl x:Class="CaveAiProForWindows.Views.KnownCaveLibraryCardsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CaveAiProForWindows.Converters">
    <UserControl.Resources>
        <conv:CoverUriToImageSourceConverter x:Key="CoverUriToImage" />
        <conv:CaveNameInitialConverter x:Key="CaveInitial" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="PlaceholderWhenNoCover" />
        <conv:StringNotNullOrEmptyToVisibilityConverter x:Key="StringToVisWhenNotEmpty" />
        <conv:SurveySiteTypeDisplayConverter x:Key="SurveySiteTypeDisplay" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding KnownCaveRows}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="236"
                            Margin="0,0,10,10"
                            Style="{StaticResource Cave.LibraryCardHost}"
                            Command="{Binding DataContext.SelectKnownCaveFromLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Select the linked survey in the list when name or Cave Library id matches; otherwise see status message.">
                        <Border Background="{DynamicResource Cave.Surface}"
                                BorderBrush="{DynamicResource Cave.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="118" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        CornerRadius="11,11,0,0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Cave.DataGridHeaderBg}">
                                    <Grid>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#3D5A4E" />
                                                    <GradientStop Offset="1" Color="#2A4038" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="44"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E8FFFFFF"
                                                   Text="{Binding Name, Converter={StaticResource CaveInitial}}"
                                                   Visibility="{Binding CoverUri, Converter={StaticResource PlaceholderWhenNoCover}}" />
                                        <Image Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Source="{Binding CoverUri, Converter={StaticResource CoverUriToImage}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="10,10,10,12">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Cave.Text}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Type, Converter={StaticResource SurveySiteTypeDisplay}}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Difficulty, StringFormat=· Difficulty {0}/10}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Depth, StringFormat=· Depth {0} m}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Length, StringFormat=· Length {0} m}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Elevation, StringFormat=Elev {0} m}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Area, StringFormat=· {0}}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Cave.TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding DateAddedText}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Cave.TextMuted}" Text="Lat " />
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.Text}"
                                                   Text="{Binding LatText}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Lon " />
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.Text}"
                                                   Text="{Binding LonText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Depth, StringFormat=Depth {0:0.#} m}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Length, StringFormat=· Len {0:0.#} m}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="{Binding Elevation, StringFormat=· El. {0:0.#} m}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Cave.Text}"
                                               TextWrapping="Wrap"
                                               MaxHeight="44"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding DescriptionPreview}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Cave.TextSubdued}"
                                               TextWrapping="Wrap"
                                               MaxHeight="36"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasScientificSummary, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding ScientificSummaryPreview}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Cave.TextMuted}"
                                               Visibility="{Binding HasCatalogHighlights, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding CatalogHighlightsCount, StringFormat=Catalog highlights {0}}" />
                                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Border Margin="0,0,6,4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cave.TabStripInactive}"
                                                BorderBrush="{DynamicResource Cave.Border}"
                                                BorderThickness="1"
                                                Visibility="{Binding SurfaceAccess, Converter={StaticResource StringToVisWhenNotEmpty}}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Cave.TextMuted}"
                                                       Text="{Binding SurfaceAccess, StringFormat=Access {0}}" />
                                        </Border>
                                        <Border Margin="0,0,6,4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cave.TabStripInactive}"
                                                BorderBrush="{DynamicResource Cave.Border}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Cave.TextMuted}"
                                                       Text="{Binding MagneticHintsCount, StringFormat=Magnetic {0}}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource Cave.Accent}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Id, StringFormat=Id {0}}"
                                               Visibility="{Binding Id, Converter={StaticResource StringToVisWhenNotEmpty}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

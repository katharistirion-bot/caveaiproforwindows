<Window x:Class="CaveAiProForWindows.Views.NetworkAnchorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network anchors"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="_Apply to project" Padding="14,5" IsDefault="True" Click="Apply_Click"
                    ToolTip="Write equates and fixed stations into the open project. Plan redraws after save." />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10"
                   Text="Equates join two station names as one point. Fixed stations are held in network least squares; optional XYZ anchors the series in plan metres (east, north, up). Values come from Walls #equate / #fix or can be typed here." />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Station equates" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add" Padding="10,3" Margin="0,0,6,0" Click="AddEquate_Click" />
                        <Button Content="Remove" Padding="10,3" Click="RemoveEquate_Click" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="EquateGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Station A" Binding="{Binding StationA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Station B" Binding="{Binding StationB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />
            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Fixed stations" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add" Padding="10,3" Margin="0,0,6,0" Click="AddFixed_Click" />
                        <Button Content="Remove" Padding="10,3" Click="RemoveFixed_Click" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="FixedGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Station" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridCheckBoxColumn Header="Hold" Binding="{Binding Hold, Mode=TwoWay}" Width="56" />
                        <DataGridTextColumn Header="X m (E)" Binding="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Y m (N)" Binding="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Z m (up)" Binding="{Binding ZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

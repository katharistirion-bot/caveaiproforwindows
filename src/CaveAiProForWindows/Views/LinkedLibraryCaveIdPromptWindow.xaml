<Window x:Class="CaveAiProForWindows.Views.LinkedLibraryCaveIdPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cave Library document id"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Padding="24,20" MinWidth="420" MaxWidth="520">
        <StackPanel>
            <TextBlock Text="Link to Public Cave Library" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" LineHeight="20"
                       Margin="0,0,0,14"
                       Text="Pick a cave from the Public Library map, or paste the document id manually (same as ?cave= in the web map URL)." />
            <Button Content="Browse Public Library…" Click="Browse_Click" Padding="10,7" Margin="0,0,0,14"
                    HorizontalAlignment="Left"
                    ToolTip="Open the in-app map browser and select a published cave" />
            <TextBlock Text="Document id" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="DocIdBox" Padding="8,6" MinWidth="360"
                     FontFamily="Consolas" FontSize="12"
                     ToolTip="Example: abc123XYZ from https://caveaipro.com/map?cave=abc123XYZ" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Width="90" Padding="12,7" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button Content="OK" IsDefault="True" Width="90" Padding="12,7"
                        Style="{StaticResource Cave.AccentButton}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="CaveAiProForWindows.Views.LinkedLibraryCaveIdPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cave Library document id"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Padding="24,20" MinWidth="400" MaxWidth="480">
        <StackPanel>
            <TextBlock Text="Link to Public Cave Library" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" LineHeight="20"
                       Margin="0,0,0,14"
                       Text="Enter the Firestore published_caves document id for this survey — the same value as the web map URL parameter ?cave=. You can copy it from the Public Cave Library address bar after opening a cave map." />
            <TextBlock Text="Document id" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="DocIdBox" Padding="8,6" MinWidth="340"
                     FontFamily="Consolas" FontSize="12"
                     ToolTip="Example: abc123XYZ from https://caveaipro.com/map?cave=abc123XYZ" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Width="90" Padding="12,7" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button Content="OK" IsDefault="True" Width="90" Padding="12,7"
                        Style="{StaticResource Cave.AccentButton}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

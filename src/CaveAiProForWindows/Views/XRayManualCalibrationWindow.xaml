<Window x:Class="CaveAiProForWindows.Views.XRayManualCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X-Ray geo calibration"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save bounds" Padding="12,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Padding="12,6" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,12"
                   Text="Set the geographic corners of the satellite backdrop (WGS-84). Saved to project extensionData as xrayManualBoundsLatLon and used for X-Ray overlay + .pgw export." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Min lat" />
            <TextBox x:Name="MinLatBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="6,4" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Max lat" />
            <TextBox x:Name="MaxLatBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="6,4" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="Min lon" />
            <TextBox x:Name="MinLonBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="6,4" />
            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Text="Max lon" />
            <TextBox x:Name="MaxLonBox" Grid.Row="3" Grid.Column="1" Padding="6,4" />
        </Grid>
    </DockPanel>
</Window>

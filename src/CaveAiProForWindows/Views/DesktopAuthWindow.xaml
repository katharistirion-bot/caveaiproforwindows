<Window x:Class="CaveAiProForWindows.Views.DesktopAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in — Push to Cloud"
        Height="720"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/logo.ico">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}"
                       Text="Sign in with your CaveAI Pro account to publish survey data to the global cave library. Your Firebase ID token is delivered securely to the desktop app via postMessage — it is never read from disk or clipboard." />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Cave.TextSubdued}"
                       Text="Loading secure sign-in…" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Offline sign-in" Click="FallbackAuth_Click" Padding="14,6" Margin="0,0,8,0"
                    ToolTip="Use bundled Firebase sign-in when the web auth page is unavailable (requires CAVEAIPRO_FIREBASE_API_KEY)" />
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" />
        </StackPanel>
        <Border Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <wv2:WebView2 x:Name="AuthWebView" />
        </Border>
    </DockPanel>
</Window>

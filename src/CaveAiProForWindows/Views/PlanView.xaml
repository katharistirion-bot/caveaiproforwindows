<UserControl x:Class="CaveAiProForWindows.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource Cave.Background}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12,8,12,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="_Print plan…" Padding="14,6" Margin="0,0,0,0"
                        Style="{StaticResource Cave.AccentButton}"
                        ToolTip="Print plan (print preview, landscape)"
                        Click="PrintPlan_Click" />
                <CheckBox x:Name="PrintHiContrastCheck" VerticalAlignment="Center" Margin="12,0,8,0"
                          Content="High-contrast print" ToolTip="Black/white for printer" />
                <CheckBox x:Name="StationNamesCheck" VerticalAlignment="Center" Margin="12,0,8,0"
                          Content="Station names" ToolTip="Label each traverse station (Compass / Walls–style)"
                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed" />
                <CheckBox x:Name="CartographyOverlayCheck" VerticalAlignment="Center" Margin="12,0,8,0"
                          Content="Scale &amp; +Y" IsChecked="True" ToolTip="Graphic scale bar and survey +Y direction"
                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed" />
                <Button Content="Reset view" Padding="10,6" Margin="12,0,0,0"
                        ToolTip="Reset zoom/pan and refit vectors to the canvas"
                        Click="ResetView_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="8,0,8,8" Padding="4" BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                Background="{DynamicResource Cave.CanvasBackdrop}" CornerRadius="4"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="HostScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          PreviewMouseWheel="HostScroll_PreviewMouseWheel">
                <Canvas x:Name="DrawingCanvas" Width="960" Height="640" ClipToBounds="True"
                        PreviewMouseDown="DrawingCanvas_PreviewMouseDown"
                        PreviewMouseMove="DrawingCanvas_PreviewMouseMove"
                        PreviewMouseUp="DrawingCanvas_PreviewMouseUp"
                        MouseLeave="DrawingCanvas_MouseLeave">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" CenterX="480" CenterY="320" />
                            <TranslateTransform x:Name="ZoomPan" X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Margin="12,0,12,8" TextWrapping="Wrap" FontSize="10.5"
                   Foreground="{DynamicResource Cave.TextMuted}" MaxHeight="44" TextTrimming="CharacterEllipsis"
                   Text="Plan — survey metres (CaveAI Pro reduction). Main window tabs: PLAN, 3D MODEL, LONG PROFILE, X-RAY, PLAN 2-TONE. Ctrl+wheel: zoom. Middle drag: pan." />
    </Grid>
</UserControl>

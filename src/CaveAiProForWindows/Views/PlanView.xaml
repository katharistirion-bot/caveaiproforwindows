<UserControl x:Class="CaveAiProForWindows.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource Cave.Background}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <Grid Margin="0" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12,8,12,6" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding DataContext.SelectedProject.Name, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                           Foreground="{DynamicResource Cave.Text}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280" />
                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="4"
                        Background="{DynamicResource Cave.BannerTint}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SelectedProjectSiteTypeLabel, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.SelectedProject, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DataContext.SelectedProjectSiteTypeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cave.AccentBrush}" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="PlanMapToolbarPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="_Print plan…" Padding="14,6" Margin="0,0,0,0"
                        Style="{StaticResource Cave.AccentButton}"
                        Command="{Binding DataContext.PrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Open print preview (ISO A4/A3/A2, landscape or portrait)" />
                <CheckBox x:Name="PrintHiContrastCheck" VerticalAlignment="Center" Margin="12,0,8,0"
                          Content="High-contrast print" ToolTip="Black/white for printer" />
                <ComboBox x:Name="MapExportQualityCombo" Width="118" VerticalAlignment="Center" Margin="0,0,8,0"
                          FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                          SelectionChanged="MapExportQualityCombo_SelectionChanged"
                          ToolTip="PNG export resolution — Standard (~300 DPI) or Print (~600 DPI)">
                    <ComboBoxItem Content="Standard" Tag="Standard" IsSelected="True" />
                    <ComboBoxItem Content="Print" Tag="Print" />
                </ComboBox>
                <Button Content="Export _PNG…" Padding="10,6" Margin="8,0,0,0"
                        ToolTip="Save full survey bounds as high-resolution PNG (Standard ~300 DPI or Print ~600 DPI)"
                        Click="ExportPlanPng_Click" />
                <Button Content="Export _SVG (vector)…" Padding="10,6" Margin="8,0,0,0"
                        ToolTip="Export traverse, walls, vectors, and stations as scalable SVG for CAD"
                        Click="ExportPlanSvg_Click" />
                <Button Content="Zoom _out" Padding="10,6" Margin="12,0,0,0"
                        ToolTip="Zoom out (mouse wheel down toward cursor, or Ctrl+wheel)"
                        Click="ZoomOut_Click" />
                <Button Content="Zoom _in" Padding="10,6" Margin="8,0,0,0"
                        ToolTip="Zoom in (mouse wheel up toward cursor, or Ctrl+wheel)"
                        Click="ZoomIn_Click" />
                <Button Content="Reset view" Padding="10,6" Margin="8,0,0,0"
                        ToolTip="Reset zoom/pan (double-click map in Pan mode)"
                        Click="ResetView_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="8,0,8,8" Padding="4" BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                Background="{DynamicResource Cave.CanvasBackdrop}" CornerRadius="4"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="EditorToolsPanel" Grid.Column="0" Margin="0,0,10,0" Padding="0" CornerRadius="6"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                        Background="{DynamicResource Cave.Surface}"
                        VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="5">
                            <StackPanel x:Name="Viewport3DToolsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBlock x:Name="Viewport3DToolsTitle" Text="3D tools" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                                <TextBlock x:Name="Viewport3DOrbitHint" TextWrapping="Wrap" Margin="0,0,0,8"
                                           FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                           Foreground="{DynamicResource Cave.TextMuted}"
                                           Text="Drag to orbit · wheel to zoom · click station to select" />
                                <CheckBox x:Name="Viewport3DShowLabelsCheck" Margin="0,0,0,8"
                                          FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                          IsChecked="False" Content="Show 3D labels"
                                          ToolTip="Uncheck to hide all floating station and leg labels on the 3D map"
                                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                          Foreground="{DynamicResource Cave.Text}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="Label chip size on the 3D viewport">
                                    <TextBlock x:Name="Viewport3DLabelSizeLabel" Text="Label size" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                    <ComboBox x:Name="Viewport3DLabelSizeCombo" Width="110"
                                              SelectionChanged="CartographyOptions_Changed"
                                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}">
                                        <ComboBoxItem Content="Small" Tag="Small" IsSelected="True" />
                                        <ComboBoxItem Content="Medium" Tag="Medium" />
                                        <ComboBoxItem Content="Large" Tag="Large" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="Viewport3DShowSplinesCheck" Margin="0,0,0,8"
                                          IsChecked="True" Content="Splays &amp; vectors"
                                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                          Foreground="{DynamicResource Cave.Text}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="LRUD tube mesh segment density">
                                    <TextBlock Text="Tube quality" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                    <ComboBox x:Name="Viewport3DTubeQualityCombo" Width="110"
                                              SelectionChanged="CartographyOptions_Changed"
                                              FontSize="{DynamicResource Cave.ToolSidebarFontSize}">
                                        <ComboBoxItem Content="Standard" Tag="Standard" IsSelected="True" />
                                        <ComboBoxItem Content="High" Tag="High" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="Viewport3DTopographyCheck" Margin="0,0,0,8"
                                          Content="Topography grid"
                                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                          Foreground="{DynamicResource Cave.Text}" />
                                <CheckBox x:Name="Viewport3DDemCheck" Margin="0,0,0,8"
                                          Content="DEM surface (GeoTIFF only)"
                                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                          Foreground="{DynamicResource Cave.Text}" />
                                <CheckBox x:Name="Viewport3DSectionCutCheck" Margin="0,0,0,8"
                                          Content="Section cut plane"
                                          Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                          Foreground="{DynamicResource Cave.Text}" />
                                <ComboBox x:Name="Viewport3DSectionCutAxisCombo" Margin="0,0,0,8"
                                          SelectionChanged="CartographyOptions_Changed"
                                          FontSize="{DynamicResource Cave.ToolSidebarFontSize}">
                                    <ComboBoxItem Content="Horizontal (Z)" Tag="HorizontalZ" IsSelected="True" />
                                    <ComboBoxItem Content="Vertical (X)" Tag="VerticalX" />
                                    <ComboBoxItem Content="Vertical (Y)" Tag="VerticalY" />
                                </ComboBox>
                                <Slider x:Name="Viewport3DSectionCutSlider" Minimum="0.05" Maximum="0.95" Value="0.5"
                                        Margin="0,0,0,10" ValueChanged="CartographyOptions_Changed" />
                                <Button x:Name="Viewport3DResetLabelsButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Reset 3D labels" Click="Viewport3DResetLabels_Click"
                                        ToolTip="Turn on all 3D labels: stations, symbols, field catalog, Android snapshots, AI tags" />
                                <Button x:Name="Viewport3DSurveyLabelsPresetButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Survey labels" Click="Viewport3DSurveyLabelsPreset_Click"
                                        ToolTip="Station names, map symbols, and field catalog only" />
                                <Button x:Name="Viewport3DCleanPresetButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Clean 3D preset" Click="Viewport3DCleanPreset_Click" />
                                <Button x:Name="Viewport3DCompetitivePresetButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Competitive 3D" Click="Viewport3DCompetitivePreset_Click"
                                        ToolTip="High tube quality, splays on, overlays off, station names only" />
                                <Button x:Name="Viewport3DFlyThroughButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Fly-through" Click="Viewport3DFlyThrough_Click" />
                                <Button x:Name="RecordFlyThroughButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Record fly-through…" Click="RecordFlyThrough_Click" />
                                <Button x:Name="Export3DPngButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Export 3D PNG" Click="Export3DPng_Click" />
                                <Button x:Name="Export3DObjButton" Margin="0,0,0,6" Padding="8,5"
                                        Content="Export 3D OBJ…" Click="Export3DObj_Click" />
                                <Button x:Name="Export3DGltfButton" Margin="0,0,0,10" Padding="8,5"
                                        Content="Export 3D glTF…" Click="Export3DGltf_Click" />
                                <Separator Margin="0,0,0,4" />
                            </StackPanel>

                            <StackPanel x:Name="PlanNavigationToolsSection">
                            <TextBlock Text="Navigation" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                       Foreground="{DynamicResource Cave.Text}"
                                       Margin="0,0,0,8" />
                            <RadioButton x:Name="EditorToolPan" GroupName="PlanMapEditorTools" Margin="0,0,0,6"
                                         IsChecked="True"
                                         FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                         Content="Pan / zoom" Checked="EditorToolPan_Checked"
                                         ToolTip="Pan and zoom the survey plan (Ctrl+1)"
                                         Foreground="{DynamicResource Cave.Text}" />
                            <RadioButton x:Name="EditorToolSelect" GroupName="PlanMapEditorTools" Margin="0,0,0,10"
                                         FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                         Content="Select station / leg" Checked="EditorToolSelect_Checked"
                                         ToolTip="Pick a traverse station or leg for QC details (Ctrl+2)"
                                         Foreground="{DynamicResource Cave.Text}" />

                            <Border Margin="0,0,0,10" Padding="8,6" CornerRadius="4"
                                    Background="{DynamicResource Cave.BannerTint}"
                                    BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                    ToolTip="Open the SKETCH EDITOR tab to draw walls, place symbols, and run procedural assist">
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                           Foreground="{DynamicResource Cave.TextMuted}"
                                           Text="Plan design (walls, symbols, ink) is edited in the SKETCH EDITOR tab. Sketch overlay on this map is read-only." />
                            </Border>

                            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                       Foreground="{DynamicResource Cave.TextMuted}"
                                       Text="Select: click a station or traverse leg · Esc clears selection · Ctrl+1 Pan · Ctrl+2 Select · Ctrl+0 reset view · +/− zoom · wheel zoom (cursor) · left/middle-drag pan · double-click map: reset view." />
                            </StackPanel>

                            <Separator x:Name="PlanCartographySeparator" Margin="0,0,0,10" />

                            <StackPanel x:Name="PlanCartographySection">
                            <TextBlock Text="Map cartography style" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                       Foreground="{DynamicResource Cave.Text}"
                                       Margin="0,0,0,8" />
                            <ComboBox x:Name="CartographicIntensityCombo" Margin="0,0,0,10"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      SelectionChanged="CartographicIntensityCombo_SelectionChanged"
                                      ToolTip="Subtle: lighter grid &amp; shadow · Balanced · Rich: stronger sketch depth (saved for all map tabs)">
                                <ComboBoxItem Content="Subtle" Tag="Subtle" />
                                <ComboBoxItem Content="Balanced" Tag="Balanced" />
                                <ComboBoxItem Content="Rich" Tag="Rich" />
                            </ComboBox>

                            <TextBlock Text="Survey detail preset" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                       Foreground="{DynamicResource Cave.Text}"
                                       Margin="0,0,0,8" />
                            <ComboBox x:Name="SurveyDetailDensityCombo" Margin="0,0,0,10"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      SelectionChanged="SurveyDetailDensityCombo_SelectionChanged"
                                      ToolTip="Minimal / Standard / Full — applies to Plan, Section, Sketch and exports">
                                <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                <ComboBoxItem Content="Standard" Tag="Standard" />
                                <ComboBoxItem Content="Full" Tag="Full" />
                            </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="PlanDisplayOptionsSection">
                            <TextBlock x:Name="PlanDisplaySectionTitle" Text="Plan display" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                       Foreground="{DynamicResource Cave.Text}"
                                       Margin="0,0,0,8" />
                            <CheckBox x:Name="StationNamesCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      Content="Station names" ToolTip="Label each traverse station"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="StationZDepthCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      Content="Show Z (elevation)" ToolTip="Plan-frame Z (m) beside each station"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="LegSurveyDetailsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Leg distances &amp; angles"
                                      ToolTip="Tape length, azimuth, clino, dZ, and LRUD on each traverse leg"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="StationEnvironmentCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Station environment"
                                      ToolTip="Temperature, humidity, O₂, CO₂, pressure at stations"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="DepthSpanAnnotationsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Depth span callouts"
                                      ToolTip="User depth braces from depthSpanAnnotations"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="BracketMarkersCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Bracket markers"
                                      ToolTip="Description and temperature pins from brackets"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="Viewport3DMapSymbolsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Map symbols (Android)"
                                      ToolTip="UIS / sketch symbols from mapSymbols and mapObjects"
                                      Visibility="Collapsed"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="Viewport3DFieldCatalogCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Field catalog / geo-bio"
                                      ToolTip="Field catalog pins, rocks, and station-linked biology/geology notes"
                                      Visibility="Collapsed"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="Viewport3DStationSnapshotsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Station env. snapshots"
                                      ToolTip="Per-station BLE / manual temperature, humidity, CO₂ from Android schema v2"
                                      Visibility="Collapsed"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="Viewport3DAiTagsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="AI classification tags"
                                      ToolTip="On-device AI labels linked to stations or shots"
                                      Visibility="Collapsed"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="LoopClosureHighlightsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Loop closure highlights"
                                      ToolTip="Highlight loop-closing traverse legs with misclosure (m/mm) and severity colour"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="LrudRibbonQcCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="LRUD ribbon QC"
                                      ToolTip="Highlight missing LRUD, zero-width passages, and degenerate wall ribbons"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="WallHatchingCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      Content="Wall hatching (LRUD fill)"
                                      ToolTip="Diagonal rock hatching inside filled passage polygons (Rich / print exports)"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="CoordinateGridCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      Content="Coordinate grid (m)"
                                      ToolTip="Survey-metre grid aligned to plan coordinates"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="CartographyOverlayCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Scale bar &amp; survey compass"
                                      ToolTip="Scale bar and compass rose (bottom-right of map)"
                                      Checked="CartographyOptions_Changed" Unchecked="CartographyOptions_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />
                            <CheckBox x:Name="ReferencePinsCheck" Margin="0,0,0,8"
                                      FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                      IsChecked="True" Content="Reference catalog pins"
                                      ToolTip="Linked reference entrance and nearby cached index pins (max 50)"
                                      Checked="ReferencePinsCheck_Changed" Unchecked="ReferencePinsCheck_Changed"
                                      Foreground="{DynamicResource Cave.Text}" />

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition x:Name="SurveyDetailsColumn" Width="250" MinWidth="230" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="MapHostGrid" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          SizeChanged="MapHostGrid_SizeChanged">
                        <Image Panel.ZIndex="-1"
                               Width="920" Height="920"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Stretch="Uniform"
                               Opacity="0.05"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/ic_launcher_logo.png" />
                        <Border x:Name="HostViewportShell" Visibility="Collapsed" Background="#FF131418"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid>
                                <Viewport3D x:Name="HostViewport3D" ClipToBounds="True"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Canvas x:Name="Viewport3DLabelCanvas"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False" />
                                <Border x:Name="Viewport3DFloatingToolbar" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,12,12,0" Padding="6,5" CornerRadius="6"
                                        Visibility="Collapsed" IsHitTestVisible="True"
                                        BorderBrush="#FF0D9488" BorderThickness="1"
                                        Background="#E8151B22">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="Viewport3DFloatShowLabelsCheck" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Content="Labels" FontSize="11"
                                                  Foreground="#FFE8F6F3"
                                                  Checked="Viewport3DFloatShowLabels_Changed"
                                                  Unchecked="Viewport3DFloatShowLabels_Changed"
                                                  ToolTip="Show or hide floating station labels on the 3D map" />
                                        <Button Content="Clean" Padding="8,4" Margin="0,0,6,0" FontSize="11"
                                                Click="Viewport3DCleanPreset_Click"
                                                ToolTip="Hide labels and splines for a clear 3D view" />
                                        <Button Content="Export PNG" Padding="8,4" FontSize="11"
                                                Click="Export3DPng_Click"
                                                ToolTip="Save the current 3D view as PNG" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Viewport3DCaveBanner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="12,12,0,0" Padding="12,9,14,10" CornerRadius="6"
                                        MaxWidth="420" IsHitTestVisible="False"
                                        BorderBrush="#FF0D9488" BorderThickness="1.5"
                                        Background="#E8151B22" Opacity="0.96" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="Viewport3DCaveNameText" FontWeight="Bold"
                                                   FontSize="16" TextWrapping="Wrap" Foreground="#FFE8F6F3" />
                                        <TextBlock x:Name="Viewport3DCaveSubText" FontSize="10.5"
                                                   Margin="0,3,0,0" Foreground="#FF94A3B8" Text="3D survey" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="Viewport3DMessage" Visibility="Collapsed" TextWrapping="Wrap"
                                           MaxWidth="520"
                                           FontSize="14" TextAlignment="Center" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" Margin="24"
                                           Foreground="#FFE8E6E2" />
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="HostScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      Background="Transparent"
                                      PreviewMouseWheel="HostScroll_PreviewMouseWheel">
                            <Grid x:Name="MapZoomRoot" MinWidth="200" MinHeight="200" Width="960" Height="640"
                                  ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" CenterX="480"
                                                        CenterY="320" />
                                        <TranslateTransform x:Name="ZoomPan" X="0" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Canvas x:Name="SurveyCanvas" Width="960" Height="640" ClipToBounds="True"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False" />
                                <Canvas x:Name="ReferencePinsLayer" Width="960" Height="640" ClipToBounds="True"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        IsHitTestVisible="False" />
                                <Canvas x:Name="DesignLayer" Width="960" Height="640" ClipToBounds="True"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        ToolTip="Navigation and QC only — edit plan design in SKETCH EDITOR"
                                        MouseLeftButtonDown="DesignLayer_MouseLeftButtonDown"
                                        MouseMove="DesignLayer_MouseMove"
                                        MouseLeftButtonUp="DesignLayer_MouseLeftButtonUp"
                                        MouseDown="DesignLayer_MouseDown"
                                        MouseUp="DesignLayer_MouseUp"
                                        MouseLeave="DesignLayer_MouseLeave" />
                            </Grid>
                        </ScrollViewer>
                        <Border x:Name="SurveyHudPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12,12,16,12"
                                Panel.ZIndex="8" Padding="12,10" CornerRadius="6" MaxWidth="280" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                Background="{DynamicResource Cave.Surface}" Opacity="0.96">
                            <StackPanel>
                                <TextBlock x:Name="HudCaveNameText" FontWeight="Bold"
                                           FontSize="{DynamicResource Cave.HudTitleFontSize}"
                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Cave.Text}" Text="—" />
                                <TextBlock Text="Survey summary" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                           Margin="0,0,0,8"
                                           Foreground="{DynamicResource Cave.TextMuted}" />
                                <TextBlock x:Name="HudStationCountText" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Cave.HudFontSize}"
                                           Foreground="{DynamicResource Cave.TextSubdued}" />
                                <TextBlock x:Name="HudLengthText" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Cave.HudFontSize}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Cave.TextSubdued}" />
                                <TextBlock x:Name="HudZSpanText" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Cave.HudFontSize}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Cave.TextSubdued}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="StationFloatingCard" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Panel.ZIndex="10" Padding="12,10,14,10" CornerRadius="8"
                                MaxWidth="280" IsHitTestVisible="False"
                                BorderThickness="1" BorderBrush="#FF22FFCC"
                                Background="#F0151B22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"
                                                  Color="#FF000000" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Station selected" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#FF22FFCC" Margin="0,0,0,4"
                                           TextWrapping="NoWrap" />
                                <TextBlock x:Name="StationCardNameText" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFFFFFFF" Margin="0,0,0,6"
                                           TextWrapping="Wrap" Text="-" />
                                <TextBlock x:Name="StationCardCoordsText" FontSize="11.5"
                                           Foreground="#FFC9D4DF" Margin="0,0,0,3"
                                           TextWrapping="Wrap" Text="-" />
                                <TextBlock x:Name="StationCardDepthText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#FFFFEC9C" Margin="0,0,0,6"
                                           TextWrapping="Wrap" Text="-" />
                                <TextBlock x:Name="StationCardLrudText" FontSize="11"
                                           Foreground="#FFB7C2CE"
                                           TextWrapping="Wrap" Text="-" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="SurveyDetailsPane" Grid.Column="1" Margin="8,0,0,0" Padding="12,12" CornerRadius="6"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                            VerticalAlignment="Stretch" Background="{DynamicResource Cave.Surface}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="PropertyPaneTitleText" DockPanel.Dock="Top" FontWeight="SemiBold"
                                       FontSize="{DynamicResource Cave.DetailsTitleFontSize}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Cave.Text}" TextWrapping="Wrap"
                                       Text="Survey overview" />
                            <Border x:Name="PropertySelectionStatusBadge" DockPanel.Dock="Top" Margin="0,0,0,10"
                                    Padding="8,4" CornerRadius="6"
                                    BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1"
                                    Background="{DynamicResource Cave.CanvasBackdrop}">
                                <TextBlock x:Name="PropertySelectionStatusText"
                                           FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                                           Foreground="{DynamicResource Cave.TextMuted}" TextWrapping="Wrap"
                                           Text="No item selected" />
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                <TextBlock x:Name="PropertyNameFieldCaption" Text="Name" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock x:Name="PropertyStationLegNameText" Margin="0,2,0,10"
                                               FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                               Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                               Text="-" />

                                <TextBlock x:Name="PropertyCoordsFieldCaption" Text="Plan XY &amp; Z elevation"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock x:Name="PropertyCoordinatesText" Margin="0,2,0,10"
                                               FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                               Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                               Text="-" />

                                <TextBlock x:Name="PropertySurveyFieldCaption" Text="Tape · azimuth · clino"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock x:Name="PropertySurveyDataText" Margin="0,2,0,10"
                                               FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                               Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                               Text="-" />

                                <TextBlock x:Name="PropertyWallFieldCaption"
                                           Text="Cross-section LRUD (Left · Right · Up · Down)"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                           Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock x:Name="PropertyWallDimensionsText" Margin="0,2,0,0"
                                               FontSize="{DynamicResource Cave.DetailsBodyFontSize}"
                                               Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                               Text="-" />

                                    <TextBlock Text="Android export (full parsed context)" FontWeight="SemiBold"
                                               FontSize="{DynamicResource Cave.ToolSidebarFontSize}"
                                               Foreground="{DynamicResource Cave.Text}"
                                               Margin="0,14,0,4" />
                                    <TextBlock x:Name="PropertyAndroidPayloadText" Margin="0,0,0,0"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource Cave.TextSubdued}" TextWrapping="Wrap"
                                               Text="—" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="PlanViewFooterHint" Grid.Row="2" Margin="12,0,12,8" TextWrapping="Wrap"
                   FontSize="{DynamicResource Cave.ToolSidebarHintFontSize}"
                   Foreground="{DynamicResource Cave.TextMuted}" MaxHeight="44" TextTrimming="CharacterEllipsis"
                   Text="Plan — survey metres (CaveAI Pro reduction). View and QC only; edit walls and symbols in SKETCH EDITOR. Zoom: wheel (toward cursor) or toolbar. Pan: left or middle drag. Double-click map (Pan mode): reset view." />
    </Grid>
</UserControl>

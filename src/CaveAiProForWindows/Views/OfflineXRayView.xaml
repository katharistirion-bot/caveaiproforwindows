<UserControl x:Class="CaveAiProForWindows.Views.OfflineXRayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Cave.Background}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock Text="X-Ray (geo-aligned)"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Cave.Text}" />
            <TextBlock Text="Satellite backdrop geo-calibrated from Android bounding box · click stations to highlight Plan/Section · wheel zoom · drag pan."
                       FontSize="11.5"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,10,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="ReferencePinsCheck"
                          Content="Reference pins"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          ToolTip="Show nearby reference catalog caves from cached index (bbox around survey, max 50)"
                          Foreground="{DynamicResource Cave.TextSubdued}" />
                <CheckBox x:Name="AiOverlayCheck"
                          Content="AI render overlay"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          ToolTip="Toggle generative map render (from Sketch Editor) as a transparent layer"
                          Foreground="{DynamicResource Cave.TextSubdued}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="Blend opacity for the generative AI map on the geo-calibrated canvas">
                    <TextBlock Text="Opacity" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource Cave.TextMuted}" />
                    <Slider x:Name="AiOverlayOpacitySlider"
                            Width="88"
                            Minimum="0.15"
                            Maximum="0.95"
                            Value="0.52"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="AiOverlayOpacitySlider_ValueChanged" />
                </StackPanel>
                <Button Content="Zoom out" Padding="10,6" Margin="0,0,6,0" Click="ZoomOut_Click"
                        ToolTip="Zoom out (mouse wheel toward cursor)" />
                <Button Content="Zoom in" Padding="10,6" Margin="0,0,6,0" Click="ZoomIn_Click"
                        ToolTip="Zoom in (mouse wheel toward cursor)" />
                <Button Content="Fit view" Padding="10,6" Margin="0,0,6,0" Click="FitView_Click"
                        ToolTip="Fit entire geo map in viewport" />
                <Button Content="Print…" Padding="10,6" Margin="0,0,6,0"
                        Command="{Binding DataContext.PrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Open print preview (ISO A4/A3/A2, landscape or portrait)" />
                <Button Content="Export geo PNG…" Padding="10,6" Margin="0,0,6,0" Click="ExportGeoMap_Click"
                        ToolTip="Save satellite raster with .pgw world file for QGIS (requires bounding box metadata)" />
                <Button Content="Reset" Padding="10,6" Click="ResetView_Click"
                        ToolTip="Reset zoom/pan (double-click map)" />
            </StackPanel>
            <TextBlock x:Name="CursorGeoText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Cave.TextMuted}"
                       Text="—" />
        </DockPanel>

        <Border Grid.Row="2"
                Background="Black"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid x:Name="MapHostGrid" Background="Black" SizeChanged="MapHostGrid_SizeChanged">
                <ScrollViewer x:Name="HostScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="Black"
                              PreviewMouseWheel="HostScroll_PreviewMouseWheel">
                    <Grid x:Name="MapZoomRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ZoomPan" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Canvas x:Name="MapCanvas" Background="Black"
                                PreviewMouseDown="MapCanvas_PreviewMouseDown"
                                PreviewMouseUp="MapCanvas_PreviewMouseUp"
                                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                                MouseMove="MapCanvas_MouseMove"
                                MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                                MouseLeave="MapCanvas_MouseLeave">
                            <Image x:Name="BackgroundRaster"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" />
                            <Canvas x:Name="ReferencePinsLayer" IsHitTestVisible="False" />
                            <Canvas x:Name="AiOverlayCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="TraverseLayer" IsHitTestVisible="True" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <Border x:Name="PlaceholderBorder"
                        Background="#E60D0F14"
                        Visibility="Collapsed">
                    <Border Padding="20"
                            MaxWidth="520"
                            Margin="24"
                            CornerRadius="10"
                            Background="{DynamicResource Cave.Surface}"
                            BorderBrush="{DynamicResource Cave.Border}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderText"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                    </Border>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,6,2,0">
            <TextBlock x:Name="AlignmentFooter"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}" />
            <TextBlock x:Name="SelectionFooter"
                       FontSize="11"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextSubdued}" />
        </StackPanel>
    </Grid>
</UserControl>

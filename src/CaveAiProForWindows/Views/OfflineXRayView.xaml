<UserControl x:Class="CaveAiProForWindows.Views.OfflineXRayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Cave.Background}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock Text="X-Ray (offline)"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Cave.Text}" />
            <TextBlock Text="Android satellite/map snapshot bundled in the backup, with traverse drawn on top. No internet."
                       FontSize="11.5"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}" />
        </StackPanel>

        <!-- Solid black canvas frame: matches Android X-Ray look. No theme grid / dotted underlay shows here. -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Background="Black"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid x:Name="MapHostGrid"
                  Background="Black"
                  SizeChanged="MapHostGrid_SizeChanged">
                <!-- Stretch=Uniform: traverse projection assumes letterboxed display so geo-aligned points match pixel positions exactly. -->
                <Image x:Name="BackgroundRaster"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
                <Canvas x:Name="TraverseCanvas"
                        Background="Transparent" />
                <Border x:Name="PlaceholderBorder"
                        Background="#E60D0F14"
                        Visibility="Collapsed">
                    <Border Padding="20"
                            MaxWidth="520"
                            Margin="24"
                            CornerRadius="10"
                            Background="{DynamicResource Cave.Surface}"
                            BorderBrush="{DynamicResource Cave.Border}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderText"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                    </Border>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="AlignmentFooter"
                   Grid.Row="2"
                   Margin="2,6,2,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Cave.TextMuted}" />
    </Grid>
</UserControl>

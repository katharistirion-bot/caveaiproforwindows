<Window x:Class="CaveAiProForWindows.Views.BatchSurveyQcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch survey QC"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,8"
                       Text="Pick a folder containing CaveAI Pro .json or .zip backups. Generates unified CSV + TXT QC report." />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FolderBox" Width="480" Padding="8,6" Margin="0,0,8,0" />
                <Button Content="Browse…" Padding="10,5" Margin="0,0,8,0" Click="Browse_Click" />
                <Button Content="Scan" Padding="10,5" Style="{StaticResource Cave.AccentButton}" Click="Scan_Click" />
                <Button Content="Export report…" Padding="10,5" Margin="8,0,0,0" Click="Export_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource Cave.TextSubdued}" />
        </StackPanel>
        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="True" IsReadOnly="True" />
    </DockPanel>
</Window>

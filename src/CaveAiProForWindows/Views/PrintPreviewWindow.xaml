<Window x:Class="CaveAiProForWindows.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print preview — CAVE AI PRO"
        Height="720"
        Width="980"
        MinHeight="480"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        Icon="pack://application:,,,/Assets/logo.ico">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Print…" Padding="14,7" Margin="0,0,8,0"
                            Style="{StaticResource Cave.AccentButton}"
                            Click="Print_Click"
                            ToolTip="Send this layout to the printer" />
                    <Button Content="Close" Padding="14,7" IsCancel="True"
                            Click="Close_Click" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="Paper" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="PaperSizeCombo"
                                  MinWidth="88"
                                  VerticalAlignment="Center"
                                  SelectionChanged="LayoutOption_Changed">
                            <ComboBoxItem Content="A4" Tag="A4" IsSelected="True" />
                            <ComboBoxItem Content="A3" Tag="A3" />
                            <ComboBoxItem Content="A2" Tag="A2" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="Orientation" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <RadioButton x:Name="LandscapeRadio" GroupName="PrintOrientation" Content="Landscape"
                                     IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Checked="LayoutOption_Changed" />
                        <RadioButton x:Name="PortraitRadio" GroupName="PrintOrientation" Content="Portrait"
                                     VerticalAlignment="Center"
                                     Checked="LayoutOption_Changed" />
                    </StackPanel>
                    <CheckBox x:Name="FitToPageCheck"
                              Content="Fit to page"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,18,0"
                              ToolTip="Scale the map uniformly to fill the printable map frame"
                              Checked="LayoutOption_Changed"
                              Unchecked="LayoutOption_Changed" />
                    <TextBlock Text="Logo, title block, scale bar &amp; survey compass scale with paper size."
                               FontSize="11" Foreground="{DynamicResource Cave.TextMuted}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border Background="White" Margin="8">
            <DocumentViewer x:Name="PreviewViewer"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Zoom="100" />
        </Border>
    </DockPanel>
</Window>

<Window x:Class="CaveAiProForWindows.Views.LibraryCavePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pick cave from Public Library"
        Height="760"
        Width="1100"
        MinHeight="520"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/logo.ico">
    <DockPanel Margin="8">
        <ToolBar DockPanel.Dock="Top" Background="{DynamicResource Cave.Surface}" Padding="4,2">
            <Button Content="← Back" Click="Back_Click" Padding="10,5" Margin="0,0,6,0" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="10,5" Margin="0,0,6,0" />
            <Separator />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Cave.TextMuted}"
                       TextWrapping="Wrap"
                       Text="Browse the map and open a cave — the document id is detected from the URL." />
            <Separator />
            <Button x:Name="UseCaveButton" Content="Use this cave" Click="UseCave_Click"
                    Padding="12,5" Margin="6,0,0,0"
                    Style="{StaticResource Cave.AccentButton}"
                    IsEnabled="False"
                    ToolTip="Select the published_caves document id from the current map URL" />
            <Button Content="Cancel" Click="Cancel_Click" Padding="10,5" Margin="6,0,0,0" IsCancel="True" />
        </ToolBar>
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
            <TextBlock x:Name="GuestLibraryLead" TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}" />
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8,6" Margin="0,8,0,0"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Detected id:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="DetectedIdText" FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource Cave.TextSubdued}" Text="(none — open a cave on the map)" />
            </StackPanel>
        </Border>
        <Border Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <wv2:WebView2 x:Name="PickerWebView" />
        </Border>
    </DockPanel>
</Window>

<Window x:Class="CaveAiProForWindows.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:loc="clr-namespace:CaveAiProForWindows.Services.Localization"
        Title="Sign in — CAVE AI PRO"
        Height="720"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/logo.ico">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"
                       Text="Sign in with Google to unlock the Desktop Companion" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}"
                       Text="An active CaveAI Pro monthly subscription (Google Play) is required. Your Firebase session is established securely in WebView2 — credentials are never stored in plain text on disk." />
            <TextBlock x:Name="CertificationHintText"
                       Visibility="Collapsed"
                       Margin="0,8,0,0"
                       Padding="10,8"
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{DynamicResource Cave.Text}"
                       Background="{DynamicResource Cave.BannerTint}"
                       Text="{x:Static loc:AppStrings.LoginCertificationTesterHint}" />
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="{DynamicResource Cave.TextSubdued}"
                       Text="Loading secure sign-in…" />

            <Border x:Name="AccessDeniedPanel"
                    Visibility="Collapsed"
                    Margin="0,12,0,0"
                    Padding="14,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#FFC62828"
                    Background="{DynamicResource Cave.AnalyticsCriticalRow}">
                <StackPanel>
                    <TextBlock Text="Subscription required"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#FFB71C1C" />
                    <TextBlock x:Name="AccessDeniedBody"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{DynamicResource Cave.Text}"
                               Text="{x:Null}" />
                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource Cave.TextSubdued}"
                               Text="{x:Static loc:AppStrings.LoginAccessDeniedPlayHint}" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button x:Name="PlayStoreButton"
                                Content="{x:Static loc:AppStrings.LoginAccessDeniedPlayStore}"
                                Click="PlayStore_Click"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                Style="{StaticResource Cave.AccentButton}" />
                        <Button x:Name="PublicLibraryButton"
                                Content="{x:Static loc:AppStrings.LoginAccessDeniedPublicLibrary}"
                                Click="PublicLibrary_Click"
                                Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="HostSignInButton"
                    Content="Sign in with Google"
                    Click="HostSignIn_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource Cave.AccentButton}"
                    ToolTip="Start Google sign-in (host navigation — use if the button inside the page does not respond)" />
            <Button x:Name="SwitchAccountButton"
                    Content="Use another account"
                    Click="SwitchAccount_Click"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    ToolTip="Clear this session and sign in again" />
            <Button x:Name="FallbackAuthButton" Content="Bundled sign-in" Click="FallbackAuth_Click" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Exit" Click="Exit_Click" Padding="14,6" Margin="0,0,8,0" />
        </StackPanel>

        <Border Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <wv2:WebView2 x:Name="AuthWebView" />
                <Border x:Name="ValidatingOverlay"
                        Visibility="Collapsed"
                        Background="#CC101218"
                        CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Width="220" Height="6" IsIndeterminate="True"
                                     Background="#FF1B1F2A" Foreground="#FF6BA9FF" BorderThickness="0" />
                        <TextBlock x:Name="ValidatingOverlayText"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFCBD2E0"
                                   Text="Verifying subscription…" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>

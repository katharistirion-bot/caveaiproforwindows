<Window x:Class="CaveAiProForWindows.Views.PostSignInWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CaveAiProForWindows.Services.Localization"
        Title="Getting started"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../IntroExperienceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="18" BorderBrush="#FF252D3D" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.Background>
                    <StaticResource ResourceKey="Intro.BackgroundGradient" />
                </Grid.Background>
                <Rectangle Fill="{StaticResource Intro.AccentGlowBrush}" IsHitTestVisible="False" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Image Width="72" Height="72" Source="pack://application:,,,/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,12" />
                    <TextBlock Text="Quick setup"
                               FontSize="18" FontWeight="SemiBold" Foreground="#FFF4F6FA"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Background="#FFF8F9FC" Padding="32,28">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BackButton" Content="{x:Static loc:AppStrings.OnboardingBack}"
                                Style="{StaticResource Intro.SecondaryButton}" Margin="0,0,8,0" Click="Back_Click" />
                        <Button x:Name="SkipButton" Content="{x:Static loc:AppStrings.OnboardingSkip}"
                                Style="{StaticResource Intro.SecondaryButton}" Margin="0,0,8,0" Click="Skip_Click" />
                        <Button x:Name="NextButton" Content="{x:Static loc:AppStrings.OnboardingNext}"
                                Style="{StaticResource Intro.PrimaryButton}" Click="Next_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#FF1A1F2E" Margin="0,0,0,10" />
                        <TextBlock x:Name="StepBody" TextWrapping="Wrap" LineHeight="24"
                                   Foreground="#FF5A6478" FontSize="14" />
                        <StackPanel x:Name="SyncFolderPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBox x:Name="SyncFolderBox" Padding="10,8" Margin="0,0,0,10" />
                            <Button Content="Browse…" Style="{StaticResource Intro.SecondaryButton}"
                                    HorizontalAlignment="Left" Click="BrowseSyncFolder_Click" />
                        </StackPanel>
                        <StackPanel x:Name="SamplePanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <Button Content="Open sample survey"
                                    Style="{StaticResource Intro.SecondaryButton}"
                                    HorizontalAlignment="Left" Click="OpenSample_Click" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

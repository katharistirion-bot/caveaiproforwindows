<Window x:Class="CaveAiProForWindows.Views.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer API Settings — Replicate (BYOK)"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/Assets/logo.ico">
    <Border Padding="28,24" MinWidth="460" MaxWidth="520">
        <StackPanel>
            <TextBlock Text="Developer mode (BYOK)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,12"
                       Text="For developers only (CAVEAIPRO_REPLICATE_BYOK=1). End users normally use CaveAI Cloud AI with Google sign-in. When BYOK is enabled, supply your own Replicate API token; it is stored only in Windows Credential Manager on this PC — never in survey files, ui-settings.json, or any upload." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,14">
                <Hyperlink NavigateUri="https://replicate.com/account/api-tokens" RequestNavigate="ReplicateLink_RequestNavigate">
                    Create or copy your token at replicate.com/account/api-tokens
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Cave.TextSubdued}" Margin="0,0,0,10" />
            <TextBlock Text="Replicate API token" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="TokenBox" Padding="8,6" MinWidth="380"
                         ToolTip="Paste your personal Replicate API token (starts with r8_)" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,8,0,0"
                       Text="Developers may set CAVEAIPRO_REPLICATE_API_TOKEN for this process only. User-saved tokens take precedence over the environment variable." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Clear" Click="Clear_Click" Padding="14,8" Margin="0,0,10,0" />
                <Button Content="Validate" Click="Validate_Click" Padding="14,8" Margin="0,0,10,0" />
                <Button Content="Save" Click="Save_Click" Padding="14,8" Margin="0,0,10,0"
                        Style="{StaticResource Cave.AccentButton}" IsDefault="True" />
                <Button Content="Close" Click="Close_Click" Padding="14,8" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

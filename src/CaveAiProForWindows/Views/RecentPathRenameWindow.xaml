<Window x:Class="CaveAiProForWindows.Views.RecentPathRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Padding="24,20" MinWidth="420" MaxWidth="560">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Rename file" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="LocationBox" IsReadOnly="True" Padding="8,6" Margin="0,0,0,14"
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                     Background="{DynamicResource Cave.SurfaceAlt}"
                     BorderBrush="{DynamicResource Cave.Border}" />
            <TextBlock Text="New name" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Padding="8,6" MinWidth="360"
                     ToolTip="File or folder name only — not the full path" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Width="90" Padding="12,7" Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button Content="Rename" IsDefault="True" Width="100" Padding="12,7"
                        Style="{StaticResource Cave.AccentButton}"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

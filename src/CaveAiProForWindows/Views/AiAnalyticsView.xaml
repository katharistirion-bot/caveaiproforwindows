<UserControl x:Class="CaveAiProForWindows.Views.AiAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CaveAiProForWindows.Models"
             Background="{DynamicResource Cave.Background}"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="HealthCard" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Background" Value="{DynamicResource Cave.CanvasBackdrop}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cave.Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HealthCardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Cave.TextMuted}" />
        </Style>
        <Style x:Key="HealthCardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Cave.Text}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="AiResultsCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="AiResultsAlertCellText" TargetType="TextBlock" BasedOn="{StaticResource AiResultsCellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AiResultsDataGridRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanSelectStation}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static models:AiAnalyticsAlertLevel.Critical}">
                    <Setter Property="Background" Value="{DynamicResource Cave.AnalyticsCriticalRow}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static models:AiAnalyticsAlertLevel.Priority}">
                    <Setter Property="Background" Value="{DynamicResource Cave.AnalyticsPriorityRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InsightRow" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Cave.CanvasBackdrop}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Cave.Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootInteractionGrid" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Left: sync + actions -->
        <Border Grid.Column="0" Padding="14,16" CornerRadius="10" Margin="10,10,0,10"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
            <DockPanel x:Name="AiAnalyticsPanel" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Survey intelligence" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,12"
                           Foreground="{DynamicResource Cave.TextMuted}"
                           Text="Offline dashboard: project health, Android sync, backup diff, batch QC, and rule-based insights. No cloud AI." />

                <TextBlock DockPanel.Dock="Top" Text="Desktop Sync" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SyncFolderDisplay}" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding LatestBackupSummary}" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource Cave.TextSubdued}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SyncHubInventoryLine}" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ImportStatusDisplay}" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,8" />

                <Button DockPanel.Dock="Top" Content="Import Android Project…" Padding="12,8" Margin="0,0,0,6"
                        FontSize="12.5" FontWeight="SemiBold"
                        Command="{Binding ImportAndroidProjectCommand}" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Sync now" Padding="10,7" Margin="0,0,6,0" FontSize="12"
                            Command="{Binding SyncNowCommand}" />
                    <Button Content="Import JSON…" Padding="10,7" FontSize="12"
                            Command="{Binding ImportAndroidExportCommand}" />
                </StackPanel>

                <CheckBox DockPanel.Dock="Top" Content="Auto-sync when Android files change"
                          IsChecked="{Binding AutoSyncEnabled}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />
                <CheckBox DockPanel.Dock="Top" Content="Auto-refresh dashboard after sync"
                          IsChecked="{Binding AutoRunAnalysisOnSync}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />
                <CheckBox DockPanel.Dock="Top" Content="Auto-refresh when project loads"
                          IsChecked="{Binding AutoRunAnalysisOnProjectLoad}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />
                <CheckBox DockPanel.Dock="Top"
                          Content="Auto-reload CaveAI_Backup_*.zip (main window)"
                          IsChecked="{Binding AutoReloadBackupZip}" Margin="0,0,0,12"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />

                <Button DockPanel.Dock="Top" Content="Refresh dashboard"
                        Style="{StaticResource Cave.AccentButton}" Padding="14,10" Margin="0,0,0,8"
                        FontSize="13" FontWeight="SemiBold"
                        Command="{Binding RefreshDashboardCommand}" />

                <Button DockPanel.Dock="Top" Content="Open Sketch Editor (QC passed)"
                        Padding="12,8" Margin="0,0,0,8" FontSize="12"
                        Command="{Binding OpenSketchEditorCommand}"
                        IsEnabled="{Binding SketchEditorReady}" />

                <Button DockPanel.Dock="Top" Content="Compare with previous backup…"
                        Padding="12,8" Margin="0,0,0,8" FontSize="12"
                        Command="{Binding CompareWithPreviousBackupCommand}"
                        ToolTip="Open Survey compare with latest vs previous Android backup ZIP" />

                <Button DockPanel.Dock="Top" Content="Loop closure assistant…"
                        Padding="12,8" Margin="0,0,0,8" FontSize="12"
                        Command="{Binding OpenLoopClosureAssistantCommand}"
                        ToolTip="Open loop closure assistant for the active project (requires detected loops)" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Export report…" Padding="10,7" Margin="0,0,6,0" FontSize="12"
                            Command="{Binding ExportExpeditionReportCommand}" />
                    <Button Content="Export CSV…" Padding="10,7" FontSize="12"
                            Command="{Binding ExportResultsCsvCommand}" />
                </StackPanel>

                <ProgressBar DockPanel.Dock="Top" Height="6" Margin="0,0,0,8"
                             IsIndeterminate="True"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource Cave.Accent}"
                             Background="{DynamicResource Cave.CanvasBackdrop}" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Cave.TextSubdued}" Margin="0,0,0,8" />

                <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,12,0,0"
                        Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource Cave.BannerTint}" BorderBrush="{DynamicResource Cave.Border}"
                        BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Cave.TextMuted}"
                               Text="All metrics computed locally. Android JSON + backup ZIP in the sync folder update this dashboard automatically." />
                </Border>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Style="{StaticResource Cave.GridSplitterVertical}" />

        <!-- Right: dashboard -->
        <ScrollViewer Grid.Column="2" Margin="0,10,10,10" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Health cards -->
                <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,10"
                        Background="{DynamicResource Cave.Surface}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Project health" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DataContext.Health.HealthSummary, ElementName=AiAnalyticsPanel}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10" />
                        <WrapPanel DataContext="{Binding DataContext.Health, ElementName=AiAnalyticsPanel}">
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Stations" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding StationCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Traverse legs" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding TraverseLegCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Max depth (m)" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding MaxDepthM, StringFormat={}{0:0.#}}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Traverse (m)" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding TraverseLengthM, StringFormat={}{0:0.#}}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Longest branch" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding LongestBranchM, StringFormat={}{0:0.#} m}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Loops" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding LoopCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Worst misclosure" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding WorstLoopMisclosureM, StringFormat={}{0:0.##} m}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Missing LRUD" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding MissingLrudLegCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="QC warnings" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding QcWarningCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HealthCard}">
                                <StackPanel>
                                    <TextBlock Text="Anomalies" Style="{StaticResource HealthCardLabel}" />
                                    <TextBlock Text="{Binding AnomalyCount}" Style="{StaticResource HealthCardValue}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Insights -->
                    <Border Grid.Column="0" Padding="14,12" CornerRadius="10"
                            Background="{DynamicResource Cave.Surface}"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Offline insights" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                            <ItemsControl DockPanel.Dock="Top"
                                          ItemsSource="{Binding DataContext.InsightRows, ElementName=AiAnalyticsPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsightRow}">
                                            <StackPanel>
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Cave.Accent}"
                                                           Text="{Binding Category}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Cave.Text}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- Backup diff -->
                    <Border Grid.Column="2" Padding="14,12" CornerRadius="10"
                            Background="{DynamicResource Cave.Surface}"
                            BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Backup comparison" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding DataContext.BackupDiffSummary, ElementName=AiAnalyticsPanel}"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Cave.Text}" />
                            <TextBlock Text="{Binding DataContext.BackupDiffDetail, ElementName=AiAnalyticsPanel}"
                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Cave.TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Batch QC -->
                <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,10"
                        Background="{DynamicResource Cave.Surface}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                    <DockPanel LastChildFill="True" MinHeight="120">
                        <TextBlock DockPanel.Dock="Top" Text="Batch QC — sync folder backups" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                        <DataGrid DockPanel.Dock="Top" MaxHeight="180"
                                  ItemsSource="{Binding DataContext.BatchQcRows, ElementName=AiAnalyticsPanel}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Cave.Surface}"
                                  Foreground="{DynamicResource Cave.Text}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="File" Binding="{Binding SourceFile}" Width="1.2*" MinWidth="120" />
                                <DataGridTextColumn Header="Shots" Binding="{Binding Shots}" Width="60" />
                                <DataGridTextColumn Header="Anom." Binding="{Binding Anomalies}" Width="52" />
                                <DataGridTextColumn Header="Loops" Binding="{Binding Loops}" Width="52" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Findings grid -->
                <Border Padding="0" CornerRadius="10"
                        Background="{DynamicResource Cave.Surface}"
                        BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
                    <DockPanel LastChildFill="True" MinHeight="200">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,6">
                            <TextBlock Text="Priority findings" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cave.Text}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Click a row with a station name to highlight it on Plan, Section, and X-Ray."
                                   FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="16,0,16,6" />
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding DataContext.ResultsSummary, ElementName=AiAnalyticsPanel}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Cave.TextMuted}" Margin="16,0,16,8" />
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Cave.Border}" Margin="16,0,16,0" />
                        <DataGrid x:Name="ResultsDataGrid"
                                  ItemsSource="{Binding DataContext.ResultRows, ElementName=AiAnalyticsPanel}"
                                  RowStyle="{StaticResource AiResultsDataGridRow}"
                                  Margin="12,10,16,16"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MaxHeight="320"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionChanged="ResultsDataGrid_SelectionChanged"
                                  Background="{DynamicResource Cave.Surface}"
                                  Foreground="{DynamicResource Cave.Text}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="80"
                                                    ElementStyle="{StaticResource AiResultsCellText}" />
                                <DataGridTextColumn Header="Android" Binding="{Binding AndroidContext}" Width="1.3*"
                                                    ElementStyle="{StaticResource AiResultsCellText}" />
                                <DataGridTextColumn Header="Geometry" Binding="{Binding GeometryContext}" Width="1.1*"
                                                    ElementStyle="{StaticResource AiResultsCellText}" />
                                <DataGridTextColumn Header="Finding" Binding="{Binding Metric}" Width="*"
                                                    ElementStyle="{StaticResource AiResultsCellText}" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Value}" Width="1.1*"
                                                    ElementStyle="{StaticResource AiResultsCellText}" />
                                <DataGridTextColumn Header="Alert" Binding="{Binding AlertLabel}" Width="80"
                                                    ElementStyle="{StaticResource AiResultsAlertCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

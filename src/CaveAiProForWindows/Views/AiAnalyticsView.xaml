<UserControl x:Class="CaveAiProForWindows.Views.AiAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CaveAiProForWindows.Models"
             Background="{DynamicResource Cave.Background}"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="AiResultsCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="AiResultsAlertCellText" TargetType="TextBlock" BasedOn="{StaticResource AiResultsCellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AiResultsDataGridRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanSelectStation}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static models:AiAnalyticsAlertLevel.Critical}">
                    <Setter Property="Background" Value="{DynamicResource Cave.AnalyticsCriticalRow}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AlertLevel}" Value="{x:Static models:AiAnalyticsAlertLevel.Priority}">
                    <Setter Property="Background" Value="{DynamicResource Cave.AnalyticsPriorityRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootInteractionGrid" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="260" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Left: control panel -->
        <Border Grid.Column="0" Padding="14,16" CornerRadius="10" Margin="10,10,0,10"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
            <DockPanel x:Name="AiAnalyticsPanel" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="AI workspace" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,14"
                           Foreground="{DynamicResource Cave.TextMuted}"
                           Text="Select an offline analysis engine, then run. Results fuse local geometry with Android field notes (survey notes, airflow, water, leads, geological markers) from the loaded backup." />

                <TextBlock DockPanel.Dock="Top" Text="Analysis model" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,8" />
                <ListBox x:Name="ModelListBox" DockPanel.Dock="Top" Margin="0,0,0,16"
                         BorderThickness="0" Background="Transparent"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="{DynamicResource Cave.CanvasBackdrop}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Cave.Border}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cave.ListItemSelected}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Cave.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cave.ListItemHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Tag="Qc" IsSelected="True">
                        <StackPanel>
                            <TextBlock Text="QC Anomaly Detection" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Cave.Text}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource Cave.TextMuted}"
                                       Text="Local statistics: standard deviation, variance thresholds, traverse loop closure." />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Volume">
                        <StackPanel>
                            <TextBlock Text="Volumetric AI Estimation" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Cave.Text}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource Cave.TextMuted}"
                                       Text="Local 3D geometry: LRUD cross-section polygons, hulls, and void integration." />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Lead">
                        <StackPanel>
                            <TextBlock Text="Lead Prediction" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource Cave.Text}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource Cave.TextMuted}"
                                       Text="Local vectors: extrapolation from open-ended stations on the traverse graph." />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <TextBlock DockPanel.Dock="Top" Text="Desktop Sync" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SyncFolderDisplay}" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ImportStatusDisplay}" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,8" />

                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                           Foreground="{DynamicResource Cave.TextMuted}"
                           Text="Place caveai_database_v1.json, android_export.json, and CaveAI_Backup_*.zip in Downloads/CaveAI (or pick a folder). With auto-sync on, JSON updates refresh AI Analytics; with auto-reload on, new ZIP backups reopen the full survey." />

                <Button DockPanel.Dock="Top" Content="Import Android Project…" Padding="12,8" Margin="0,0,0,6"
                        FontSize="12.5" FontWeight="SemiBold"
                        Command="{Binding ImportAndroidProjectCommand}"
                        ToolTip="Choose the synchronized folder containing caveai_database_v1.json and android_export.json" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Sync now" Padding="10,7" Margin="0,0,6,0" FontSize="12"
                            Command="{Binding SyncNowCommand}"
                            ToolTip="Reload caveai_database_v1.json + android_export.json from the sync folder" />
                    <Button Content="Import JSON…" Padding="10,7" FontSize="12"
                            Command="{Binding ImportAndroidExportCommand}"
                            ToolTip="Pick a single JSON file manually" />
                </StackPanel>

                <CheckBox DockPanel.Dock="Top" Content="Auto-sync when Android files change"
                          IsChecked="{Binding AutoSyncEnabled}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />

                <CheckBox DockPanel.Dock="Top" Content="Auto-run analysis after sync"
                          IsChecked="{Binding AutoRunAnalysisOnSync}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />

                <CheckBox DockPanel.Dock="Top" Content="Auto-run analysis when project loads"
                          IsChecked="{Binding AutoRunAnalysisOnProjectLoad}" Margin="0,0,0,6"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />

                <CheckBox DockPanel.Dock="Top"
                          Content="Auto-reload CaveAI_Backup_*.zip (full survey sync)"
                          IsChecked="{Binding AutoReloadBackupZip}" Margin="0,0,0,14"
                          ToolTip="When Android exports a new backup ZIP to the sync folder, reload the entire survey in the main window"
                          Foreground="{DynamicResource Cave.TextSubdued}" FontSize="12" />

                <Button DockPanel.Dock="Top" Content="Run diagnostic pipeline"
                        Style="{StaticResource Cave.AccentButton}" Padding="14,10" Margin="0,0,0,10"
                        FontSize="13" FontWeight="SemiBold"
                        Command="{Binding RunAnalysisCommand}" />

                <ProgressBar DockPanel.Dock="Top" Height="6" Margin="0,0,0,8"
                             IsIndeterminate="True"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource Cave.Accent}"
                             Background="{DynamicResource Cave.CanvasBackdrop}" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Cave.TextSubdued}" Margin="0,0,0,8" />

                <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,16,0,0"
                        Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource Cave.BannerTint}" BorderBrush="{DynamicResource Cave.Border}"
                        BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Cave.TextMuted}"
                               Text="All metrics are computed locally from the loaded project; nothing is sent over the network." />
                </Border>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Style="{StaticResource Cave.GridSplitterVertical}" />

        <!-- Right: results -->
        <Border Grid.Column="2" Margin="0,10,10,10" Padding="0" CornerRadius="10"
                Background="{DynamicResource Cave.Surface}"
                BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,8">
                    <TextBlock Text="Results" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cave.Text}" VerticalAlignment="Center" />
                    <Button Content="Export CSV…" Padding="10,6" Margin="12,0,0,0" FontSize="12"
                            Command="{Binding DataContext.ExportResultsCsvCommand, ElementName=AiAnalyticsPanel}"
                            ToolTip="Save the Results grid as UTF-8 CSV for spreadsheets or GIS" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Click a row with an Android field note to highlight that station on Plan, Section, and X-Ray."
                           FontSize="11" Foreground="{DynamicResource Cave.TextMuted}" Margin="16,0,16,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding DataContext.ResultsSummary, ElementName=AiAnalyticsPanel}"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Cave.TextMuted}" Margin="16,0,16,8" />
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Cave.Border}" Margin="16,0,16,0" />
                <DataGrid x:Name="ResultsDataGrid"
                          ItemsSource="{Binding DataContext.ResultRows, ElementName=AiAnalyticsPanel}"
                          RowStyle="{StaticResource AiResultsDataGridRow}"
                          Margin="12,10,16,16"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectionChanged="ResultsDataGrid_SelectionChanged"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="{DynamicResource Cave.Surface}"
                          Foreground="{DynamicResource Cave.Text}"
                          BorderThickness="0"
                          RowBackground="{DynamicResource Cave.DataGridRow}"
                          AlternatingRowBackground="{DynamicResource Cave.DataGridRowAlt}"
                          VerticalAlignment="Stretch"
                          MinHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="90"
                                            MinWidth="72" ElementStyle="{StaticResource AiResultsCellText}" />
                        <DataGridTextColumn Header="Android" Binding="{Binding AndroidContext}" Width="1.4*"
                                            MinWidth="140" ElementStyle="{StaticResource AiResultsCellText}" />
                        <DataGridTextColumn Header="Geometry" Binding="{Binding GeometryContext}" Width="1.2*"
                                            MinWidth="120" ElementStyle="{StaticResource AiResultsCellText}" />
                        <DataGridTextColumn Header="Finding" Binding="{Binding Metric}" Width="*"
                                            MinWidth="140" ElementStyle="{StaticResource AiResultsCellText}" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Value}" Width="1.2*"
                                            MinWidth="120" ElementStyle="{StaticResource AiResultsCellText}" />
                        <DataGridTextColumn Header="Alert" Binding="{Binding AlertLabel}" Width="88"
                                            MinWidth="72" ElementStyle="{StaticResource AiResultsAlertCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

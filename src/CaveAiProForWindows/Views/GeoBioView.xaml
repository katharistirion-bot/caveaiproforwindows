<UserControl x:Class="CaveAiProForWindows.Views.GeoBioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Cave.Background}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Geo &amp; Bio (offline scientific reader)"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Cave.Text}" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="11.5"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}"
                       Text="Cave AI analyses, rock textures, organisms, bacteria, plants, and per-cave field catalog — fully offline from Android backup JSON." />
            <TextBlock x:Name="CatalogSummaryText"
                       FontSize="11.5"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextSubdued}" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,10,0,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Cave.Border}">
            <TabItem x:Name="GeologyTab" Header="GEOLOGY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel>
                        <Border x:Name="GlobalAnalysisBorder"
                                Padding="12"
                                CornerRadius="8"
                                Margin="0,0,0,12"
                                Background="{DynamicResource Cave.Surface}"
                                BorderBrush="{DynamicResource Cave.Border}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Global Cave AI analysis"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Cave.Text}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="GlobalAnalysisText"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Cave.Text}"
                                               LineHeight="20"
                                               FontSize="13" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="GeologyItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="12"
                                            Background="{DynamicResource Cave.Surface}"
                                            BorderBrush="{DynamicResource Cave.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Image Source="{Binding HeroImage}"
                                                       Width="200"
                                                       Height="160"
                                                       Stretch="UniformToFill"
                                                       Cursor="Hand"
                                                       Tag="{Binding}"
                                                       MouseLeftButtonUp="HeroImage_MouseLeftButtonUp"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HeroImageVisibility}" />
                                                <Border Width="200" Height="160"
                                                        Background="{DynamicResource Cave.CanvasBackdrop}"
                                                        BorderBrush="{DynamicResource Cave.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding NoImageVisibility}">
                                                    <TextBlock Text="(no photo)"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding ExtraImages}"
                                                              Margin="0,8,0,0"
                                                              Visibility="{Binding ExtraImagesVisibility}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding Bitmap}"
                                                                   Width="62" Height="46"
                                                                   Margin="0,0,4,4"
                                                                   Stretch="UniformToFill"
                                                                   Cursor="Hand"
                                                                   Tag="{Binding}"
                                                                   MouseLeftButtonUp="ExtraImage_MouseLeftButtonUp"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   ToolTip="{Binding Caption}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Cave.Text}"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,4,0,8">
                                                    <Border Background="{DynamicResource Cave.BannerTint}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CategoryLabel}"
                                                                   Foreground="{DynamicResource Cave.Text}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding StationLabel}"
                                                               Foreground="{DynamicResource Cave.TextMuted}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding SourceLabel}"
                                                               Foreground="{DynamicResource Cave.TextSubdued}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding StructuredFacts}"
                                                           Margin="0,0,0,8"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding StructuredFactsVisibility}" />

                                                <ScrollViewer MaxHeight="280"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Visibility="{Binding AnalysisVisibility}">
                                                    <TextBlock Text="{Binding AnalysisText}"
                                                               FontSize="13"
                                                               LineHeight="20"
                                                               Foreground="{DynamicResource Cave.Text}"
                                                               TextWrapping="Wrap" />
                                                </ScrollViewer>

                                                <TextBlock Text="{Binding DetailsSummary}"
                                                           Margin="0,8,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding DetailsVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="GeologyEmptyBorder"
                                Padding="12"
                                CornerRadius="6"
                                Background="{DynamicResource Cave.BannerTint}"
                                BorderBrush="{DynamicResource Cave.Border}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="GeologyEmptyText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Cave.TextMuted}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="BiologyTab" Header="BIOLOGY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <StackPanel>
                        <ItemsControl x:Name="BiologyItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="12"
                                            Background="{DynamicResource Cave.Surface}"
                                            BorderBrush="{DynamicResource Cave.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Image Source="{Binding HeroImage}"
                                                       Width="200"
                                                       Height="160"
                                                       Stretch="UniformToFill"
                                                       Cursor="Hand"
                                                       Tag="{Binding}"
                                                       MouseLeftButtonUp="HeroImage_MouseLeftButtonUp"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HeroImageVisibility}" />
                                                <Border Width="200" Height="160"
                                                        Background="{DynamicResource Cave.CanvasBackdrop}"
                                                        BorderBrush="{DynamicResource Cave.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding NoImageVisibility}">
                                                    <TextBlock Text="(no photo)"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Cave.TextMuted}" />
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding ExtraImages}"
                                                              Margin="0,8,0,0"
                                                              Visibility="{Binding ExtraImagesVisibility}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding Bitmap}"
                                                                   Width="62" Height="46"
                                                                   Margin="0,0,4,4"
                                                                   Stretch="UniformToFill"
                                                                   Cursor="Hand"
                                                                   Tag="{Binding}"
                                                                   MouseLeftButtonUp="ExtraImage_MouseLeftButtonUp"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   ToolTip="{Binding Caption}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Cave.Text}"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,4,0,8">
                                                    <Border Background="{DynamicResource Cave.BannerTint}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CategoryLabel}"
                                                                   Foreground="{DynamicResource Cave.Text}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding StationLabel}"
                                                               Foreground="{DynamicResource Cave.TextMuted}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding SourceLabel}"
                                                               Foreground="{DynamicResource Cave.TextSubdued}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding StructuredFacts}"
                                                           Margin="0,0,0,8"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding StructuredFactsVisibility}" />

                                                <ScrollViewer MaxHeight="280"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Visibility="{Binding AnalysisVisibility}">
                                                    <TextBlock Text="{Binding AnalysisText}"
                                                               FontSize="13"
                                                               LineHeight="20"
                                                               Foreground="{DynamicResource Cave.Text}"
                                                               TextWrapping="Wrap" />
                                                </ScrollViewer>

                                                <TextBlock Text="{Binding DetailsSummary}"
                                                           Margin="0,8,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Cave.TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding DetailsVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="BiologyEmptyBorder"
                                Padding="12"
                                CornerRadius="6"
                                Background="{DynamicResource Cave.BannerTint}"
                                BorderBrush="{DynamicResource Cave.Border}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="BiologyEmptyText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Cave.TextMuted}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CatalogTableTab" Header="CATALOG TABLE">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Filter kind:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                        <ComboBox x:Name="CatalogKindFilterCombo" MinWidth="200"
                                  SelectionChanged="CatalogKindFilterCombo_SelectionChanged" />
                    </StackPanel>

                    <DataGrid x:Name="CatalogDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowBackground="{DynamicResource Cave.DataGridRow}"
                              AlternatingRowBackground="{DynamicResource Cave.DataGridRowAlt}"
                              Background="{DynamicResource Cave.Surface}"
                              BorderBrush="{DynamicResource Cave.Border}"
                              Foreground="{DynamicResource Cave.Text}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Scientific name" Binding="{Binding ScientificName}" Width="150" />
                            <DataGridTextColumn Header="Group / category" Binding="{Binding TaxonomicGroup}" Width="120" />
                            <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="70" />
                            <DataGridTextColumn Header="Abundance" Binding="{Binding Abundance}" Width="80" />
                            <DataGridTextColumn Header="Life stage" Binding="{Binding LifeStage}" Width="80" />
                            <DataGridTextColumn Header="Microhabitat" Binding="{Binding Microhabitat}" Width="110" />
                            <DataGridTextColumn Header="Substrate" Binding="{Binding Substrate}" Width="90" />
                            <DataGridTextColumn Header="ID conf." Binding="{Binding IdConfidence}" Width="70" />
                            <DataGridTextColumn Header="Analysis" Binding="{Binding AnalysisPreview}" Width="2*" />
                            <DataGridTextColumn Header="Photo" Binding="{Binding HasPhoto}" Width="48" />
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecordedAt}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="CatalogEmptyBorder"
                            Grid.Row="1"
                            Padding="12"
                            CornerRadius="6"
                            Background="{DynamicResource Cave.BannerTint}"
                            BorderBrush="{DynamicResource Cave.Border}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="CatalogEmptyText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Cave.TextMuted}" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="CaveAiProForWindows.Views.SnackbarHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Bottom"
             HorizontalAlignment="Right"
             Margin="0,0,24,28"
             Panel.ZIndex="999"
             IsHitTestVisible="True"
             Focusable="False"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="SnackbarFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Card"
            CornerRadius="10"
            Background="#FF1F2430"
            BorderBrush="#FF2E3441"
            BorderThickness="1"
            MaxWidth="520"
            Padding="14,10"
            RenderTransformOrigin="1,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="CardSlide" Y="20" />
                <ScaleTransform />
            </TransformGroup>
        </Border.RenderTransform>
        <DockPanel LastChildFill="True">
            <Button x:Name="DismissButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SnackbarFlatButton}"
                    Width="26" Height="26"
                    Margin="6,0,0,0"
                    ToolTip="Dismiss"
                    Click="DismissButton_Click">
                <TextBlock Text="✕"
                           Foreground="#FF8A93A6"
                           FontSize="12" />
            </Button>
            <Button x:Name="ActionButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SnackbarFlatButton}"
                    Margin="14,0,0,0"
                    Visibility="Collapsed"
                    Click="ActionButton_Click">
                <TextBlock x:Name="ActionLabel"
                           Text="REVEAL"
                           Foreground="#FF6BA9FF"
                           FontSize="12" />
            </Button>
            <TextBlock x:Name="MessageText"
                       Foreground="#FFEFF2F8"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Border>
</UserControl>

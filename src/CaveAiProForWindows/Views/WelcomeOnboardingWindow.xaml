<Window x:Class="CaveAiProForWindows.Views.WelcomeOnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to CAVE AI PRO"
        Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../IntroExperienceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="18" BorderBrush="#FF252D3D" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Grid Grid.Column="0">
                <Grid.Background>
                    <StaticResource ResourceKey="Intro.BackgroundGradient" />
                </Grid.Background>
                <Rectangle Fill="{StaticResource Intro.AccentGlowBrush}" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False" Opacity="0.18">
                    <Path Stroke="#FF5B9DFF" StrokeThickness="1.2"
                          Data="M 20,380 C 80,340 140,400 200,360 S 280,320 300,350" />
                </Canvas>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
                    <Image Width="88" Height="88" Stretch="Uniform"
                           Source="pack://application:,,,/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,0,16">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="#FF5B9DFF" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="CAVE AI PRO"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFF4F6FA"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Desktop companion for cave surveyors"
                               FontSize="12"
                               Foreground="#FF8B95A8"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,24"
                               MaxWidth="240" />
                    <StackPanel x:Name="StepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="Dot0" Style="{StaticResource Intro.StepDotActive}" />
                        <Ellipse x:Name="Dot1" Style="{StaticResource Intro.StepDot}" />
                        <Ellipse x:Name="Dot2" Style="{StaticResource Intro.StepDot}" />
                        <Ellipse x:Name="Dot3" Style="{StaticResource Intro.StepDot}" />
                        <Ellipse x:Name="Dot4" Style="{StaticResource Intro.StepDot}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Content panel -->
            <Border Grid.Column="1" Background="#FFF8F9FC">
                <Grid Margin="36,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleBlock"
                               Grid.Row="0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF5B9DFF"
                               Margin="0,0,0,6" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border x:Name="StepIconBadge"
                                Width="44" Height="44"
                                CornerRadius="12"
                                Background="#FFE7F0FF"
                                Margin="0,0,14,0">
                            <TextBlock x:Name="StepIconBlock"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="StepTitleBlock"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1A1F2E"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               x:Name="StepBodyBlock"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="#FF5A6478"
                               FontSize="14"
                               Opacity="1" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="SkipButton"
                                Content="Skip"
                                Style="{StaticResource Intro.SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="Skip_Click" />
                        <Button x:Name="BackButton"
                                Content="Back"
                                Style="{StaticResource Intro.SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="Back_Click" />
                        <Button x:Name="NextButton"
                                Content="Next"
                                Style="{StaticResource Intro.PrimaryButton}"
                                IsDefault="True"
                                Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

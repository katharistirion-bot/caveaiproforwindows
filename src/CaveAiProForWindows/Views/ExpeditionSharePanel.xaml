<UserControl x:Class="CaveAiProForWindows.Views.ExpeditionSharePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Padding="10,8" Margin="0,8,0,0"
            Background="{DynamicResource Cave.Surface}"
            BorderBrush="{DynamicResource Cave.Border}"
            BorderThickness="1" CornerRadius="4">
        <StackPanel>
            <TextBlock Text="Expedition share (subscriber map)"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource Cave.Text}" />
            <TextBlock Text="Opt-in approximate position for other CaveAI Pro subscribers. Not emergency SAR."
                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextMuted}" />
            <TextBlock x:Name="StatusText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Cave.TextSubdued}" Text="Not sharing." />
            <TextBlock x:Name="ErrorText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="#F87171" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Expected exit" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,8,0" />
                <ComboBox x:Name="ExpectedExitCombo" Width="120" SelectedIndex="0">
                    <ComboBoxItem Content="Not set" />
                    <ComboBoxItem Content="4 hours" />
                    <ComboBoxItem Content="8 hours" />
                    <ComboBoxItem Content="12 hours" />
                </ComboBox>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="StartButton" Content="Share on map" Padding="10,6" Margin="0,0,8,6"
                        Click="StartButton_Click" />
                <Button x:Name="EndButton" Content="Stop sharing" Padding="10,6" Margin="0,0,8,6"
                        Click="EndButton_Click" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
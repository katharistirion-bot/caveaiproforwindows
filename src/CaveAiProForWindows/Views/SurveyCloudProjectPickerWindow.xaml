<Window x:Class="CaveAiProForWindows.Views.SurveyCloudProjectPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open survey from cloud"
        Height="480"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Your private survey projects synced from CaveAI Pro (Android). Select one to import into this session."/>
        <ListView x:Name="ProjectsList" Grid.Row="1" SelectionMode="Single"
                  DisplayMemberPath="DisplayLine"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Width="90" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Open" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Open_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

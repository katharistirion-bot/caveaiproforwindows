<Window x:Class="CaveAiProForWindows.Views.CaveAiOfflineQaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cave AI — offline Q&amp;A"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,10"
                   Text="Rule-based answers from the selected project — no Cloud AI or network required. Ask about depth, traverse length, shots, trip report, or site type (English)." />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBox x:Name="QueryBox" MinHeight="28" Margin="0,0,0,8"
                     ToolTip="e.g. What is the max depth? What site type is this?" />
            <Button Content="Ask" HorizontalAlignment="Right" Padding="16,6" Click="Ask_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="AnswerText" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
        </ScrollViewer>
    </DockPanel>
</Window>

<UserControl x:Class="CaveAiProForWindows.Views.CaveLibraryCardsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CaveAiProForWindows.Converters">
    <UserControl.Resources>
        <conv:CoverUriToImageSourceConverter x:Key="CoverUriToImage" />
        <conv:CaveNameInitialConverter x:Key="CaveInitial" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="PlaceholderWhenNoCover" />
        <conv:StringNotNullOrEmptyToVisibilityConverter x:Key="StringToVisWhenNotEmpty" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding CaveRegistryRows}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="228"
                            Margin="0,0,10,10"
                            Style="{StaticResource Cave.LibraryCardHost}"
                            Command="{Binding DataContext.SelectCaveFromRegistryRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Open this cave in the survey panel (Cave Library–style cards).">
                        <Border Background="{DynamicResource Cave.Surface}"
                                BorderBrush="{DynamicResource Cave.Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="118" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        CornerRadius="11,11,0,0"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Cave.DataGridHeaderBg}">
                                    <Grid>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#4C6B8E" />
                                                    <GradientStop Offset="1" Color="#2D3F5C" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="44"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E8FFFFFF"
                                                   Text="{Binding CaveName, Converter={StaticResource CaveInitial}}"
                                                   Visibility="{Binding CoverUri, Converter={StaticResource PlaceholderWhenNoCover}}" />
                                        <Image Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Source="{Binding CoverUri, Converter={StaticResource CoverUriToImage}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="10,10,10,12">
                                    <TextBlock Text="{Binding CaveName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Foreground="{DynamicResource Cave.Text}" />
                                    <TextBlock Text="{Binding Date}"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Cave.TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Lat " />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.Text}"
                                                   Text="{Binding Lat}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Lon " />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.Text}"
                                                   Text="{Binding Lon}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text="Entrance alt " />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.Text}"
                                                   Text="{Binding AltM, StringFormat=F1}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Cave.TextMuted}"
                                                   Text=" m" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Border Margin="0,0,6,4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cave.TabStripInactive}"
                                                BorderBrush="{DynamicResource Cave.Border}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Cave.TextMuted}"
                                                       Text="{Binding TraverseLegs, StringFormat=Traverse {0}}" />
                                        </Border>
                                        <Border Margin="0,0,6,4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cave.TabStripInactive}"
                                                BorderBrush="{DynamicResource Cave.Border}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Cave.TextMuted}"
                                                       Text="{Binding TotalShots, StringFormat=Shots {0}}" />
                                        </Border>
                                        <Border Margin="0,0,6,4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="{DynamicResource Cave.TabStripInactive}"
                                                BorderBrush="{DynamicResource Cave.Border}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Cave.TextMuted}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Rocks {0} · Cat. {1}">
                                                        <Binding Path="RocksCount" />
                                                        <Binding Path="FieldCatalogCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Cave.Accent}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding LibraryLinkId, StringFormat=Cave Library id: {0}}"
                                               Visibility="{Binding LibraryLinkId, Converter={StaticResource StringToVisWhenNotEmpty}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

<Window x:Class="CaveAiProForWindows.Views.AiRenderCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI render preview — structure mask vs result"
        Width="960" Height="520"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Compare your structure mask (left) with the AI render (right). Close to continue editing."
                   TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" Padding="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Structure mask" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="MaskImage" Stretch="Uniform" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Cave.Border}" BorderThickness="1" Padding="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="AI render" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cave.Text}" Margin="0,0,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ResultImage" Stretch="Uniform" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="16,8" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>

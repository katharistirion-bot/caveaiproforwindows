<Window x:Class="CaveAiProForWindows.Views.SurveyCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Survey compare — legs &amp; stations"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cave.Background}"
        Foreground="{DynamicResource Cave.Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Cave.TextMuted}" Margin="0,0,0,8"
                       Text="Open two backups and compare traverse legs and station coordinates for one project name." />
            <StackPanel Orientation="Horizontal">
                <Button Content="File A…" Padding="12,6" Margin="0,0,8,0" Click="PickA_Click" />
                <TextBlock x:Name="TxtA" VerticalAlignment="Center" Text="(none)" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="File B…" Padding="12,6" Margin="0,0,8,0" Click="PickB_Click" />
                <TextBlock x:Name="TxtB" VerticalAlignment="Center" Text="(none)" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Project:" />
                <ComboBox x:Name="ProjectCombo" MinWidth="220" Margin="0,0,8,0" />
                <Button Content="Compare" Padding="14,6" Style="{StaticResource Cave.AccentButton}" Click="Compare_Click" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Legs">
                <DataGrid x:Name="LegGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}" />
            </TabItem>
            <TabItem Header="Stations">
                <DataGrid x:Name="StationGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{DynamicResource Cave.Surface}" BorderBrush="{DynamicResource Cave.Border}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

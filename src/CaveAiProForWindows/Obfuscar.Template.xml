  <!-- Rename + control-flow + string hiding for implementation code -->
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="ReuseNames" value="false" />
  <Var name="HideStrings" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="RegenerateDebugInfo" value="false" />

  <AssemblySearchPath path="@INPATH@" />
  <AssemblySearchPath path="@CORE_REF_PATH@" />
  <AssemblySearchPath path="@DESKTOP_REF_PATH@" />

  <Module file="@INPATH@CaveAiProForWindows.dll" />

  <!-- WPF shell (x:Class / Application entry) -->
  <SkipType name="CaveAiProForWindows.App" />
  <SkipType name="CaveAiProForWindows.MainWindow" />
  <SkipType name="CaveAiProForWindows.GeneratedInternalTypeHelper" />

  <!-- JSON data models (System.Text.Json property names / round-trip with Android) -->

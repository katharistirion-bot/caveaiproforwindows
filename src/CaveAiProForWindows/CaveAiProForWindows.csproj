<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CaveAiProForWindows</RootNamespace>
    <AssemblyName>CaveAiProForWindows</AssemblyName>
    <StartupObject>CaveAiProForWindows.Program</StartupObject>
    <ApplicationTitle>CAVE AI PRO</ApplicationTitle>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Product>CAVE AI PRO for Windows</Product>
    <Company>Georgios Kourentzis</Company>
    <Copyright>Copyright © 2026 Georgios Kourentzis. All rights reserved.</Copyright>
    <!-- Required so restore includes win-x64 assets when publishing self-contained / single-file. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Distribution / IP-hardening (see Properties/PublishProfiles/ReleaseSingleFile-Win64.pubxml for the full
    single-file + self-contained stack). PublishSingleFile and SelfContained are kept in that profile only
    so plain "dotnet build -c Release" still lands under bin\Release\net8.0-windows\ (no inferred win-x64 RID).

    ReadyToRun improves startup and precompiles more code to native images, but it is not a substitute for a
    commercial obfuscator: managed metadata and IL can still be inspected. PublishTrimmed stays off because
    WPF + SkiaSharp are reflection-heavy without verified trim roots.

    Publish command (final portable exe, no separate .NET install):
      dotnet publish src/CaveAiProForWindows/CaveAiProForWindows.csproj -c Release -r win-x64 -p:PublishProfile=ReleaseSingleFile-Win64
  -->
  <!--
    Microsoft Store (MSIX): dotnet publish -c Release -p:PublishProfile=MicrosoftStore-Win64
    defines STORE_DISTRIBUTION (skips Velopack bootstrap + in-app updates; relaxes install guard for WindowsApps).
    Store certification review only: MicrosoftStore-Review-Win64 adds MICROSOFT_TEST_MODE + STORE_REVIEW_UNLOCKED (see package-store-msix-review.ps1).
    Sideload / GitHub: use package-release.ps1 or ReleaseSingleFile-Win64 without STORE_DISTRIBUTION.
  -->
  <PropertyGroup Label="Distribution publish defaults (non-RID build safe)">
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CaveAiProForWindows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="MSBuild.Obfuscar" Version="2.2.49">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Restore net8.0 reference assemblies to NuGet cache for Obfuscar on CI (SDK preview packs may lack net8.0 ref). -->
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="8.0.18" Condition="'$(Configuration)' == 'Release' and '$(ObfuscatorEnabled)' != 'false'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="8.0.18" Condition="'$(Configuration)' == 'Release' and '$(ObfuscatorEnabled)' != 'false'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <Resource Include="Assets\ic_launcher_logo.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.ico" />
    <!-- Debug-only dev toggle; never ship to Store / Release (subscription gate must stay enforced). -->
    <Content Include="appsettings.json" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Certification\certification-demo-survey.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\DesktopAuth\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Intro\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Intro\intro.mp4" Condition="Exists('Assets\Intro\intro.mp4')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\surface-map\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\field-trip-map\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="build\Obfuscation.targets" />
  <Import Project="build\VerifyFirebaseConfig.targets" />

  <Target Name="WritePublishManifest" AfterTargets="Publish">
    <PropertyGroup>
      <_ManifestRid Condition="'$(RuntimeIdentifier)' == ''">unspecified</_ManifestRid>
      <_ManifestRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ManifestRid>
      <_PubDir>$([MSBuild]::EnsureTrailingSlash($(PublishDir)))</_PubDir>
      <_ManifestJson>{"assembly":"$(AssemblyName)","version":"$(Version)","targetFramework":"$(TargetFramework)","runtimeIdentifier":"$(_ManifestRid)","configuration":"$(Configuration)"}</_ManifestJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PubDir)publish-manifest.json" Lines="$(_ManifestJson)" Overwrite="true" Encoding="utf-8" />
  </Target>
</Project>

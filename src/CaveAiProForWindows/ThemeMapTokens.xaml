<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Speleological cartography palette — limestone passage, rock-brown walls -->
    <SolidColorBrush x:Key="Map.TraverseStroke" Color="#FF5C4538" />
    <SolidColorBrush x:Key="Map.TraverseGlow" Color="#555C4538" />
    <SolidColorBrush x:Key="Map.TraverseGuide" Color="#AA6B5A4A" />
    <SolidColorBrush x:Key="Map.WallStroke" Color="#FF7C4A2D" />
    <SolidColorBrush x:Key="Map.WallStrokeAlt" Color="#FF8B6914" />
    <SolidColorBrush x:Key="Map.SketchFill" Color="#72C4A07A" />
    <SolidColorBrush x:Key="Map.VectorFill" Color="#4814B8A6" />
    <SolidColorBrush x:Key="Map.VectorStroke" Color="#FF14B8A6" />
    <SolidColorBrush x:Key="Map.StationFill" Color="#FFFFFBF5" />
    <SolidColorBrush x:Key="Map.StationRing" Color="#FF6B5344" />
    <SolidColorBrush x:Key="Map.SplayStroke" Color="#8894788A" />
    <SolidColorBrush x:Key="Map.PassageFill" Color="#88E8DCC8" />
    <SolidColorBrush x:Key="Map.PassageStroke" Color="#DD5C4033" />
    <SolidColorBrush x:Key="Map.PassageRim" Color="#77FFF8EE" />
    <SolidColorBrush x:Key="Map.CanvasWarm" Color="#FFF0E4D0" />
    <SolidColorBrush x:Key="Map.CanvasCool" Color="#FFFAF6EE" />
</ResourceDictionary>

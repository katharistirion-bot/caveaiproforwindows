<?xml version="1.0" encoding="utf-8"?>
<!--
  Generates Obfuscar.xml from Obfuscar.Template.xml using the active $(TargetDir).
  MSBuild.Obfuscar runs the Obfuscator target on Release builds only.
-->
<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ObfuscatorEnabled Condition="'$(ObfuscatorEnabled)' == ''">true</ObfuscatorEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <_ObfRefTfm Condition="'$(_ObfRefTfm)' == ''">net8.0</_ObfRefTfm>
  </PropertyGroup>

  <Target Name="_ResolveObfuscarReferencePaths"
          Returns="$(_ObfCoreRefPath);$(_ObfDesktopRefPath)">
    <Exec Command="powershell -NoProfile -Command &quot;$tfm='$(_ObfRefTfm)'; $marker='System.Text.Json.dll'; $searchRoots=@(); if ('$(NuGetPackageRoot)' -ne '') { $searchRoots += (Join-Path '$(NuGetPackageRoot)' 'microsoft.netcore.app.ref') }; $pf=$env:ProgramFiles; if ($pf) { $searchRoots += (Join-Path $pf 'dotnet\packs\Microsoft.NETCore.App.Ref') }; if ($env:DOTNET_ROOT) { $searchRoots += (Join-Path $env:DOTNET_ROOT 'packs\Microsoft.NETCore.App.Ref') }; $sdkRoot='$(NetCoreSdkRoot)'; if ($sdkRoot -and (Test-Path $sdkRoot)) { $searchRoots += (Join-Path (Split-Path (Split-Path $sdkRoot -Parent) -Parent) 'packs\Microsoft.NETCore.App.Ref') }; foreach ($root in ($searchRoots | Select-Object -Unique)) { if (-not (Test-Path $root)) { continue }; $pack = Get-ChildItem -Path $root -Directory -ErrorAction SilentlyContinue | Sort-Object { try { [Version]$_.Name } catch { [Version]'0.0.0' } } -Descending | Select-Object -First 1; if (-not $pack) { continue }; $path = Join-Path $pack.FullName (Join-Path 'ref' $tfm); if (Test-Path (Join-Path $path $marker)) { Write-Output $path; exit 0 } }; exit 1&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ObfCoreRefPath" />
    </Exec>
    <Exec Command="powershell -NoProfile -Command &quot;$tfm='$(_ObfRefTfm)'; $marker='PresentationFramework.dll'; $searchRoots=@(); if ('$(NuGetPackageRoot)' -ne '') { $searchRoots += (Join-Path '$(NuGetPackageRoot)' 'microsoft.windowsdesktop.app.ref') }; $pf=$env:ProgramFiles; if ($pf) { $searchRoots += (Join-Path $pf 'dotnet\packs\Microsoft.WindowsDesktop.App.Ref') }; if ($env:DOTNET_ROOT) { $searchRoots += (Join-Path $env:DOTNET_ROOT 'packs\Microsoft.WindowsDesktop.App.Ref') }; $sdkRoot='$(NetCoreSdkRoot)'; if ($sdkRoot -and (Test-Path $sdkRoot)) { $searchRoots += (Join-Path (Split-Path (Split-Path $sdkRoot -Parent) -Parent) 'packs\Microsoft.WindowsDesktop.App.Ref') }; foreach ($root in ($searchRoots | Select-Object -Unique)) { if (-not (Test-Path $root)) { continue }; $pack = Get-ChildItem -Path $root -Directory -ErrorAction SilentlyContinue | Sort-Object { try { [Version]$_.Name } catch { [Version]'0.0.0' } } -Descending | Select-Object -First 1; if (-not $pack) { continue }; $path = Join-Path $pack.FullName (Join-Path 'ref' $tfm); if (Test-Path (Join-Path $path $marker)) { Write-Output $path; exit 0 } }; exit 1&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ObfDesktopRefPath" />
    </Exec>
    <PropertyGroup>
      <_ObfCoreRefPath>$([System.IO.Path]::GetFullPath('$(_ObfCoreRefPath.Trim())'))$([System.IO.Path]::DirectorySeparatorChar)</_ObfCoreRefPath>
      <_ObfDesktopRefPath>$([System.IO.Path]::GetFullPath('$(_ObfDesktopRefPath.Trim())'))$([System.IO.Path]::DirectorySeparatorChar)</_ObfDesktopRefPath>
    </PropertyGroup>
  </Target>

  <Target Name="_GenerateObfuscarConfiguration"
          BeforeTargets="Obfuscator"
          DependsOnTargets="_ResolveObfuscarReferencePaths"
          Condition="'$(Configuration)' == 'Release' and '$(ObfuscatorEnabled)' == 'true'">
    <PropertyGroup>
      <_ObfInPath>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_ObfInPath>
      <_ObfOutPath>$([System.IO.Path]::GetFullPath('$(TargetDir)obfuscated\'))</_ObfOutPath>
      <_ObfTemplatePath>$(MSBuildProjectDirectory)\Obfuscar.Template.xml</_ObfTemplatePath>
      <_ObfConfigPath>$(MSBuildProjectDirectory)\Obfuscar.xml</_ObfConfigPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_ObfTemplatePath)')"
           Text="Missing Obfuscar template at $(_ObfTemplatePath)" />
    <Error Condition="!Exists('$(_ObfCoreRefPath)System.Text.Json.dll')"
           Text="Unable to resolve .NET reference assemblies for Obfuscar (NuGet packages or SDK targeting packs)." />
    <Error Condition="!Exists('$(_ObfDesktopRefPath)PresentationFramework.dll')"
           Text="Unable to resolve WPF reference assemblies for Obfuscar (NuGet packages or SDK targeting packs)." />

    <ReadLinesFromFile File="$(_ObfTemplatePath)">
      <Output TaskParameter="Lines" ItemName="_ObfTemplateLines" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_ObfConfigLines Include="@(_ObfTemplateLines->Replace('@INPATH@', '$(_ObfInPath)')->Replace('@OUTPATH@', '$(_ObfOutPath)')->Replace('@CORE_REF_PATH@', '$(_ObfCoreRefPath)')->Replace('@DESKTOP_REF_PATH@', '$(_ObfDesktopRefPath)'))" />
    </ItemGroup>

    <WriteLinesToFile File="$(_ObfConfigPath)"
                      Lines="@(_ObfConfigLines)"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

  <Target Name="_RemoveObfuscarConfiguration"
          BeforeTargets="Obfuscator"
          Condition="'$(Configuration)' == 'Release' and '$(ObfuscatorEnabled)' != 'true'">
    <Delete Files="$(MSBuildProjectDirectory)\Obfuscar.xml" Condition="Exists('$(MSBuildProjectDirectory)\Obfuscar.xml')" />
  </Target>
  <!-- Override MSBuild.Obfuscar: generate Obfuscar.xml from template every Release build (never use a committed copy). -->
  <Target Name="Obfuscator"
          AfterTargets="AfterBuild"
          DependsOnTargets="CheckPrerequisites;_GenerateObfuscarConfiguration"
          Condition="'$(Configuration)' == 'Release' and '$(ObfuscatorEnabled)' == 'true'">
    <MakeDir Directories="$(TargetDir)obfuscated" />
    <Exec WorkingDirectory="$(ProjectDir)" Command="$(ObfuscateCommand)" />
    <ItemGroup>
      <FilesToMove Include="$(TargetDir)obfuscated\*.*" />
    </ItemGroup>
    <Move SourceFiles="@(FilesToMove)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" Condition=" '$(OS)' == 'Windows_NT'" />
    <RemoveDir Directories="$(TargetDir)obfuscated" Condition=" '$(OS)' == 'Windows_NT'" />
  </Target>

</Project>

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Unlock: CaveAi DLL copy",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/c",
        "taskkill /F /IM CaveAiProForWindows.exe >nul 2>&1 & taskkill /F /IM netcoredbg.exe >nul 2>&1 & exit /b 0"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "build (after unlock)",
      "dependsOrder": "sequence",
      "dependsOn": ["Unlock: CaveAi DLL copy", "build"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Release, after unlock)",
      "dependsOrder": "sequence",
      "dependsOn": ["Unlock: CaveAi DLL copy", "build (Release)"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/CaveAiProForWindows/CaveAiProForWindows.csproj",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build (Release)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/CaveAiProForWindows/CaveAiProForWindows.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run (Debug, no installer)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/CaveAiProForWindows/CaveAiProForWindows.csproj",
        "-c",
        "Debug",
        "--no-launch-profile"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CAVEAI_DEV_SKIP_INSTALL_CHECK": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "group": "none"
    }
  ]
}
